    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^14.0 || dev-main"
    },
    "autoload": {
        "psr-4": {
            "Bmack\\K8sHealth\\": "Classes/"
        }
    },
    "extra": {
