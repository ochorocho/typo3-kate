{
    "name": "ochorocho/kate-imgproxy",
    "type": "typo3-cms-extension",
    "description": "typo3-kate: images through imgproxy. Configures EXT:media_processing from the environment the Helm chart sets, and serves the stored results instead of the internal imgproxy URL",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.3",
        "somehow-digital/typo3-media-processing": "^1.0",
        "typo3/cms-core": "^14.0 || dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ochorocho\\KateImgproxy\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ochorocho\\KateImgproxy\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "kate_imgproxy"
        }
    }
}
