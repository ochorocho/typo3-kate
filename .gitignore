# Composer
/vendor/
/public/
/var/

# Generated by `typo3 setup`: the DDEV database credentials and encryption key.
# Provide your own settings (or environment variables) on other systems.
/config/system/settings.php

# DDEV
/.ddev/config.local.yaml
/.ddev/db_snapshots/
/.ddev/.homeadditions/

# Composer auth (may contain tokens)
/auth.json

# Your cluster settings: domain, tokens, Helm overrides (see kate.example.yaml)
/kate.yaml

# OS and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/

# ddev-k3s: generated kubeconfig and image tarballs
/.ddev/k3s/output/
/.ddev/k3s/images/

# Editor swap files (may hold unsaved secrets, e.g. from infra/.env)
*.swp
*.swo
