apiVersion: v1
kind: Namespace
metadata:
  name: headlamp
---
# Installed by the k3s Helm controller, no helm binary needed.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: headlamp
  namespace: kube-system
spec:
  repo: https://kubernetes-sigs.github.io/headlamp/
  chart: headlamp
  targetNamespace: headlamp
  valuesContent: |-
    service:
      type: NodePort
      nodePort: ${node_port}
---
# Login identity for the dashboard (token: scripts/dashboard-token.sh).
apiVersion: v1
kind: ServiceAccount
metadata:
  name: dashboard-admin
  namespace: headlamp
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: dashboard-admin
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin
subjects:
  - kind: ServiceAccount
    name: dashboard-admin
    namespace: headlamp
---
apiVersion: v1
kind: Secret
metadata:
  name: dashboard-admin-token
  namespace: headlamp
  annotations:
    kubernetes.io/service-account.name: dashboard-admin
type: kubernetes.io/service-account-token
