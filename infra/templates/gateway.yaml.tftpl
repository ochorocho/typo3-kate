# Gateway API on k3s' bundled Traefik (the CRDs ship with k3s).
# public-gateway serves plain HTTP (redirect to HTTPS) and HTTPS on the node
# IPs with the cluster CA, for the one project that answers there. Projects
# with a domain bring their own Gateway and certificate in their namespace
# (k8s/project-manifests.sh); Traefik serves them all on port 443.
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    providers:
      kubernetesGateway:
        enabled: true
    # We create our own GatewayClass and Gateway below.
    gateway:
      enabled: false
    gatewayClass:
      enabled: false
---
apiVersion: gateway.networking.k8s.io/v1
kind: GatewayClass
metadata:
  name: traefik
spec:
  controllerName: traefik.io/gateway-controller
---
apiVersion: v1
kind: Namespace
metadata:
  name: gateway-system
---
# Certificate for all node IPs, signed by the cluster CA (infra/cluster-ca.crt).
apiVersion: v1
kind: Secret
metadata:
  name: gateway-tls
  namespace: gateway-system
type: kubernetes.io/tls
data:
  tls.crt: ${tls_crt}
  tls.key: ${tls_key}
---
# Browsers send no SNI for IP addresses, so Traefik would answer with its own
# "TRAEFIK DEFAULT CERT". Make our certificate Traefik's default instead
# (a TLSStore can only use Secrets from Traefik's namespace).
apiVersion: v1
kind: Secret
metadata:
  name: gateway-tls
  namespace: kube-system
type: kubernetes.io/tls
data:
  tls.crt: ${tls_crt}
  tls.key: ${tls_key}
---
apiVersion: traefik.io/v1alpha1
kind: TLSStore
metadata:
  name: default
  namespace: kube-system
spec:
  defaultCertificate:
    secretName: gateway-tls
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: public-gateway
  namespace: gateway-system
spec:
  gatewayClassName: traefik
  listeners:
    # Port 8000 = Traefik's "web" entrypoint (port 80 on every node).
    # Only the redirect below attaches here.
    - name: http
      protocol: HTTP
      port: 8000
      allowedRoutes:
        namespaces:
          from: Same
    # Port 8443 = Traefik's "websecure" entrypoint (port 443 on every node).
    - name: https
      protocol: HTTPS
      port: 8443
      tls:
        mode: Terminate
        certificateRefs:
          - name: gateway-tls
      allowedRoutes:
        namespaces:
          from: Selector
          selector:
            matchLabels:
              gateway-access: public
---
# Redirect plain HTTP to HTTPS for everything
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: http-to-https
  namespace: gateway-system
spec:
  parentRefs:
    - name: public-gateway
      sectionName: http
  rules:
    - filters:
        - type: RequestRedirect
          requestRedirect:
            scheme: https
            statusCode: 301
