#!/usr/bin/env bash
# typo3-kate: deploy, create, inspect and remove the TYPO3 sites in projects/
# on the libvirt cluster from infra/. Asks (with gum) for whatever is missing
# on the command line; with every argument given it asks nothing.
#
#   ./kate                                   menu
#   ./kate deploy [<site>|--all] [--no-build]   (--all and the menu leave out kate)
#   ./kate new [<site>] [--domain <domain>] [--acme staging|production]
#              [--namespace <ns>] [--php 8.5|8.4] [--node-ips] [--from <site>]
#   ./kate status
#   ./kate remove [<site>] [--yes] [--delete-volumes]
#   ./kate password [<site>] [--copy]          backend login of a site
#   ./kate garage [<site>] [--address <ip>] [--port <n>] [--copy]  Garage's web admin
#   ./kate logs [<site>] [<component>] [-f] [--since 1h] [--tail 100]
#   ./kate certificates                        the saved certificate copies
#   ./kate reprocess [<site>]                  make every processed image again
#   ./kate composer <site> [<arguments>]       composer for a site, with its own PHP
#   ./kate dns [--ip <ipv4>] [--ttl 300] [--yes]  A record *.<acme.wildcard.domain>
#   ./kate values <site-url> [--hostname <domain>] [--node-ips]       (CI)
#   ./kate manifests [--hostname <domain> --issuer <issuer>] [--node-ips]  (CI)
#   ./kate autocomplete [bash|zsh] [--print]   tab completion for your shell
#
# Settings: projects/<site>/kate.yaml (domain, acme.environment, namespace,
#           nodeIPs, helm:), ./kate.yaml (git-ignored, cluster-wide)
# Env:      KUBECONFIG (default infra/kubeconfig), REGISTRY (default: tofu
#           output), RELEASE (typo3)
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
RELEASE="${RELEASE:-typo3}"
BUILDER=typo3-kate
KATE_FILE="${ROOT}/kate.yaml"
# PHP versions with a prebuilt base image (docker/base.Dockerfile,
# .github/workflows/base-image.yml); the first is the default
PHP_VERSIONS="8.5 8.4"
BASE_IMAGE="${BASE_IMAGE:-ghcr.io/ochorocho/typo3-kate-base}"

# --- ui ------------------------------------------------------------------------
# Messages go to stderr, so `values` and `manifests` print only YAML.
command -v gum >/dev/null || { echo "Error: gum is not installed (https://github.com/charmbracelet/gum)" >&2; exit 1; }
step() { echo >&2; gum style --bold --foreground 212 "$*" >&2; }
note() { gum style --faint "$*" >&2; }
fail() { gum style --foreground 196 "Error: $*" >&2; exit 1; }
interactive() { [ -t 0 ] && [ -t 2 ]; }
# ask_choose <what> <header> <option>...: one option, or fail without a terminal
ask_choose() {
  local what="$1" header="$2"
  shift 2
  interactive || fail "missing ${what}: pass it on the command line"
  gum choose --header "${header}" "$@"
}
# ask_input <what> <header> [<value>] [<placeholder>]
ask_input() {
  interactive || fail "missing $1: pass it on the command line"
  gum input --header "$2" --value "${3:-}" --placeholder "${4:-}"
}
# wait_for <title> <command>...: a spinner on a terminal, the output on failure
wait_for() {
  local title="$1"
  shift
  if [ -t 2 ]; then
    gum spin --show-error --title "${title}" -- "$@"
  else
    note "${title}"
    "$@"
  fi
}
need() {
  local tool
  for tool in "$@"; do
    command -v "${tool}" >/dev/null || fail "${tool} is not installed"
  done
}

# --- projects --------------------------------------------------------------------
# Folders in projects/ with a composer.json; _example is only a template.
list_projects() {
  local dir
  for dir in "${ROOT}"/projects/*/; do
    [ -f "${dir}composer.json" ] || continue
    basename "${dir}"
  done
}

valid_name() { [[ "$1" =~ ^[a-z0-9]([-a-z0-9]{0,40}[a-z0-9])?$ ]]; }

# load_project <site>: PROJECT, PROJECT_DIR, PROJECT_FILE, NAMESPACE, DOMAIN,
# ACME_ENVIRONMENT, NODE_IPS, ADMIN_USERNAME, ADMIN_EMAIL. Without a domain the
# site answers on the node IPs.
load_project() {
  PROJECT="$1"
  valid_name "${PROJECT}" \
    || fail "site name '${PROJECT}': lowercase letters, digits and dashes only (it names the image and namespace)"
  PROJECT_DIR="${ROOT}/projects/${PROJECT}"
  [ -f "${PROJECT_DIR}/composer.json" ] || fail "no projects/${PROJECT}/composer.json"
  PROJECT_FILE="${PROJECT_DIR}/kate.yaml"
  setting() { if [ -f "${PROJECT_FILE}" ]; then yq -r "$1" "${PROJECT_FILE}"; else echo "$2"; fi; }
  NAMESPACE="$(setting ".namespace // \"${PROJECT}\"" "${PROJECT}")"
  DOMAIN="$(setting '.domain // ""' "")"
  ACME_ENVIRONMENT="$(setting '.acme.environment // "staging"' staging)"
  NODE_IPS="$(setting '.nodeIPs // false' false)"
  [ -n "${DOMAIN}" ] || NODE_IPS=true
  [[ "${ACME_ENVIRONMENT}" == staging || "${ACME_ENVIRONMENT}" == production ]] \
    || fail "acme.environment in projects/${PROJECT}/kate.yaml must be staging or production"
  # Its DNS provider for DNS-01 (acme.providers in ./kate.yaml)
  ACME_PROVIDER="$(setting '.acme.provider // ""' "")"
  # The backend admin `typo3 setup` creates on the first install
  ADMIN_USERNAME="$(setting '.admin.username // "admin"' admin)"
  ADMIN_EMAIL="$(setting '.admin.email // "admin@typo3-kate.local"' admin@typo3-kate.local)"
  [[ "${ADMIN_USERNAME}" =~ ^[A-Za-z0-9._@-]{1,50}$ ]] \
    || fail "admin.username in projects/${PROJECT}/kate.yaml: letters, digits and . _ @ - only, at most 50"
  [[ "${ADMIN_EMAIL}" =~ ^[^@[:space:]]+@[^@[:space:]]+$ ]] \
    || fail "admin.email in projects/${PROJECT}/kate.yaml is not an email address"
  # PHP version: one with a prebuilt base image
  PHP_VERSION="$(setting ".php // \"${PHP_VERSIONS%% *}\"" "${PHP_VERSIONS%% *}")"
  php_supported "${PHP_VERSION}" \
    || fail "php: ${PHP_VERSION} in projects/${PROJECT}/kate.yaml: one of ${PHP_VERSIONS} (those have a base image)"
  # imgproxy instead of ImageMagick (ochorocho/kate-imgproxy in composer.json)
  IMGPROXY="$(setting '.imgproxy.enabled // false' false)"
  [[ "${IMGPROXY}" == true || "${IMGPROXY}" == false ]] \
    || fail "imgproxy.enabled in projects/${PROJECT}/kate.yaml must be true or false"
}

# imgproxy_check: a site with imgproxy needs a domain (imgproxy fetches
# originals through it) and the glue package in its composer.lock
imgproxy_check() {
  [ "${IMGPROXY}" = true ] || return 0
  [ -n "${DOMAIN}" ] \
    || fail "imgproxy.enabled needs a domain in projects/${PROJECT}/kate.yaml: imgproxy fetches the originals through it"
  jq -e '.packages[] | select(.name == "ochorocho/kate-imgproxy")' "${PROJECT_DIR}/composer.lock" >/dev/null 2>&1 \
    || fail "imgproxy.enabled needs ochorocho/kate-imgproxy: ./kate composer ${PROJECT} require ochorocho/kate-imgproxy:@dev"
}

php_supported() { [[ " ${PHP_VERSIONS} " == *" $1 "* ]]; }

# --- cluster -----------------------------------------------------------------------
# connect: KUBECONFIG, REGISTRY, MASTER_IP and WORK_DIR (removed on exit,
# together with the SSH tunnel, if one was needed)
TUNNEL_CTL=""
WORK_DIR=""
cleanup() {
  if [ -n "${TUNNEL_CTL}" ]; then
    ssh -S "${TUNNEL_CTL}" -O exit "ubuntu@${MASTER_IP}" 2>/dev/null || true
  fi
  [ -z "${WORK_DIR}" ] || rm -rf "${WORK_DIR}"
}
trap cleanup EXIT

connect() {
  export KUBECONFIG="${KUBECONFIG:-${ROOT}/infra/kubeconfig}"
  [ -f "${KUBECONFIG}" ] || fail "no kubeconfig at ${KUBECONFIG} (run tofu apply in infra/)"
  # tofu prints "No outputs found" to stdout (and exits 0) for a state without a cluster
  REGISTRY="${REGISTRY:-$(tofu -chdir="${ROOT}/infra" output -raw registry 2>/dev/null || true)}"
  [[ "${REGISTRY}" =~ ^[A-Za-z0-9.-]+:[0-9]+$ ]] \
    || fail "no cluster in infra/'s state (tofu output registry is empty): run tofu apply in infra/, or set REGISTRY=<master-ip>:30500"
  MASTER_IP="${REGISTRY%%:*}"
  WORK_DIR="$(mktemp -d)"
  # macOS may block kubectl/helm from the VM subnet (Local Network privacy)
  # while ssh is allowed. Then talk to the API through an SSH tunnel on
  # localhost; the k3s API certificate is valid for 127.0.0.1.
  kubectl get --raw /readyz >/dev/null 2>&1 && return
  note "API not reachable directly, using an SSH tunnel to ${MASTER_IP}"
  local port="" candidate
  # The first free local port, so several deploys can run at the same time
  for candidate in $(seq 16443 16463); do
    if ssh -f -N -M -S "${WORK_DIR}/ctl" -o ExitOnForwardFailure=yes \
        -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR \
        -L "127.0.0.1:${candidate}:127.0.0.1:6443" "ubuntu@${MASTER_IP}" 2>/dev/null; then
      port="${candidate}"
      break
    fi
  done
  [ -n "${port}" ] || fail "no SSH tunnel to ${MASTER_IP} (ports 16443-16463 busy or ssh refused)"
  TUNNEL_CTL="${WORK_DIR}/ctl"
  sed "s#https://${MASTER_IP}:6443#https://127.0.0.1:${port}#" "${KUBECONFIG}" > "${WORK_DIR}/kubeconfig"
  export KUBECONFIG="${WORK_DIR}/kubeconfig"
  kubectl get --raw /readyz >/dev/null || fail "cluster not reachable, also not through SSH"
}

k() { kubectl -n "${NAMESPACE}" "$@"; }
secret_value() { k get secret "$1" -o jsonpath="{.data.$2}" | base64 -d; }

# --- values: Helm values from a site's URL and domain ----------------------------
#   --hostname <domain>  the site's own Gateway "site" (manifests), routes for this host only
#   --node-ips           also infra's public-gateway (https listener, node IPs), any host
# Without either: public-gateway only, for any host.
cmd_values() {
  local usage="Usage: ./kate values <site-url> [--hostname <domain>] [--node-ips]"
  [ $# -ge 1 ] || fail "${usage}"
  local site_url="${1%/}" hostname="" node_ips=false
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --hostname) [ $# -ge 2 ] || fail "${usage}"; hostname="$2"; shift 2 ;;
      --node-ips) node_ips=true; shift ;;
      *) fail "${usage}" ;;
    esac
  done
  [ -n "${hostname}" ] || node_ips=true

  local refs=() hostnames="[]"
  if [ -n "${hostname}" ]; then
    refs+=('{"name": "site", "sectionName": "https"}')
    hostnames="[\"${hostname}\"]"
  fi
  if [ "${node_ips}" = true ]; then
    refs+=('{"name": "public-gateway", "namespace": "gateway-system", "sectionName": "https"}')
    hostnames="[]"   # node IPs carry no hostname
  fi
  SITE_URL="${site_url}" PARENT_REFS="[$(IFS=,; echo "${refs[*]}")]" HOSTNAMES="${hostnames}" yq -n '
    .typo3.extraEnv.TYPO3_S3_PUBLIC_URL = strenv(SITE_URL) + "/media/typo3/" |
    .mercure.publicUrl = strenv(SITE_URL) + "/.well-known/mercure" |
    .imgproxy.sourceUrl = strenv(SITE_URL) |
    .httpRoute.parentRefs = env(PARENT_REFS) |
    .httpRoute.hostnames = env(HOSTNAMES)'
}

# --- manifests: the per-site routing, applied into the site's namespace ------------
#  - Gateway "site": one HTTPS listener for the domain. Every Gateway on port
#    8443 lands on Traefik's websecure entrypoint; Traefik picks the
#    certificate by SNI, so sites never touch infra's public-gateway.
#  - Certificate "site": Let's Encrypt for the domain (secret site-tls), via
#    the ClusterIssuers from infra/templates/acme.yaml.tftpl
#  - HTTPRoute "media": /media/ -> Garage, attached like the chart's route
# With --certificate-ref <namespace>/<secret> instead of --issuer the listener
# uses that Secret (the wildcard certificate in gateway-system, allowed by a
# ReferenceGrant there) and no Certificate is printed.
# Without a domain only the media route (node IPs, public-gateway).
cmd_manifests() {
  local usage="Usage: ./kate manifests [--hostname <domain> (--issuer <cluster-issuer> [--dns-provider <name>] | --certificate-ref <namespace>/<secret>)] [--node-ips]"
  local hostname="" issuer="" ref="" provider="" values_args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --hostname) [ $# -ge 2 ] || fail "${usage}"; hostname="$2"; values_args+=(--hostname "$2"); shift 2 ;;
      --issuer) [ $# -ge 2 ] || fail "${usage}"; issuer="$2"; shift 2 ;;
      --certificate-ref) [ $# -ge 2 ] || fail "${usage}"; ref="$2"; shift 2 ;;
      --dns-provider) [ $# -ge 2 ] || fail "${usage}"; provider="$2"; shift 2 ;;
      --node-ips) values_args+=(--node-ips); shift ;;
      *) fail "${usage}" ;;
    esac
  done
  if [ -n "${hostname}" ]; then
    { [ -n "${issuer}" ] && [ -z "${ref}" ]; } || { [ -z "${issuer}" ] && [[ "${ref}" == */* ]]; } || fail "${usage}"
  fi

  local cert_ref="          - name: site-tls"
  [ -z "${ref}" ] || cert_ref="          - name: ${ref#*/}
            namespace: ${ref%%/*}"

  if [ -n "${hostname}" ]; then
    cat <<YAML
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: site
spec:
  gatewayClassName: traefik
  listeners:
    # Port 8443 = Traefik's "websecure" entrypoint (port 443 on every node)
    - name: https
      hostname: "${hostname}"
      protocol: HTTPS
      port: 8443
      tls:
        mode: Terminate
        certificateRefs:
${cert_ref}
      allowedRoutes:
        namespaces:
          from: Same
---
YAML
  fi
  if [ -n "${hostname}" ] && [ -z "${ref}" ]; then
    cat <<YAML
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: site${provider:+
  labels:
    typo3-kate/dns-provider: ${provider}}
spec:
  secretName: site-tls
  dnsNames:
    - "${hostname}"
  issuerRef:
    kind: ClusterIssuer
    name: ${issuer}
---
YAML
  fi

  # The URL only matters for values this route doesn't use
  local route
  route="$(cmd_values https://unused ${values_args[@]+"${values_args[@]}"} | yq -o json -I0 '.httpRoute')"
  echo "# https://<site>/media/<key> -> Garage web endpoint, bucket \"media\"."
  echo "# Longer than the chart's \"/\" route, so it wins for /media."
  ROUTE="${route}" yq -n '
    .apiVersion = "gateway.networking.k8s.io/v1" |
    .kind = "HTTPRoute" |
    .metadata.name = "media" |
    .spec.parentRefs = env(ROUTE).parentRefs |
    .spec.hostnames = env(ROUTE).hostnames |
    .spec.rules = [{
      "matches": [{"path": {"type": "PathPrefix", "value": "/media/"}}],
      "filters": [{"type": "URLRewrite", "urlRewrite": {"hostname": "media", "path": {"type": "ReplacePrefixMatch", "replacePrefixMatch": "/"}}}],
      "backendRefs": [{"name": "garage", "port": 3902}]
    }] |
    del(.spec.hostnames | select(length == 0)) |
    ... style = ""'
}

# --- deploy --------------------------------------------------------------------------
# 1. builds the site's production image (docker/Dockerfile) and pushes it to
#    the cluster registry; the release uses its digest
# 2. creates the site's namespace and, once, the Secrets with random passwords
# 3. its Gateway, certificate and media route (cmd_manifests)
# 4. applies k8s/platform/ (MariaDB, Valkey, Garage S3, RWX volumes) and waits
# 5. empty database only: `typo3 setup` in a one-off pod (schema + admin user),
#    then the root page and sample pages (k8s/bootstrap.sql). The chart's
#    migrations hook can't do this: extension:setup needs be_users to exist.
# 6. `helm upgrade --install` with k8s/charts/typo3. Values, last one wins:
#    k8s/values/cluster.yaml, ./kate.yaml helm:, cmd_values, the site's helm:
cmd_deploy() {
  local project="" all=false build=true asked=false arg
  for arg in "$@"; do
    case "${arg}" in
      --no-build) build=false ;;
      --all) all=true ;;
      -*) fail "Usage: ./kate deploy [<site>|--all] [--no-build]" ;;
      *) [ -z "${project}" ] || fail "one site, or --all"; project="${arg}" ;;
    esac
  done
  local projects
  projects="$(list_projects)"
  [ -n "${projects}" ] || fail "no site in projects/ yet: ./kate new"

  # The kate site is neither offered nor part of --all: deploy it by name
  local others
  others="$(grep -vx kate <<<"${projects}" || true)"
  if [ "${all}" = false ] && [ -z "${project}" ]; then
    [ -n "${others}" ] || fail "no site besides kate to choose from: ./kate deploy kate, or create one with ./kate new"
    # shellcheck disable=SC2086 # one site per line
    project="$(ask_choose "<site> (or --all)" "Deploy which site?" ${others} "all sites")"
    asked=true
    if gum confirm "Build a new image? (No: redeploy the current one)"; then build=true; else build=false; fi
  fi
  if [ "${all}" = true ] || [ "${project}" = "all sites" ]; then
    local flags=() p
    [ "${build}" = true ] || flags+=(--no-build)
    [ -n "${others}" ] || fail "no site besides kate for --all: ./kate deploy kate"
    for p in ${others}; do
      "$0" deploy "${p}" ${flags[@]+"${flags[@]}"}
    done
    return
  fi

  load_project "${project}"
  need docker kubectl helm jq yq openssl tofu
  imgproxy_check
  if [ "${asked}" = true ]; then
    gum style --border rounded --padding "0 1" >&2 \
      "Site:      ${PROJECT}" "Namespace: ${NAMESPACE}" \
      "Domain:    ${DOMAIN:-(none, node IPs)}" \
      "Let's Encrypt: $(if [ -n "$(wildcard_for "${DOMAIN}")" ]; then echo "*.${WILDCARD_DOMAIN} (${WILDCARD_ENVIRONMENT}, ${WILDCARD_PROVIDER:-$(dns_default)})"; elif [ -n "${DOMAIN}" ]; then echo "${ACME_ENVIRONMENT}, DNS provider ${ACME_PROVIDER:-$(dns_default)}"; else echo "-"; fi)" \
      "Node IPs:  ${NODE_IPS}" "PHP:       ${PHP_VERSION}" \
      "Images:    $([ "${IMGPROXY}" = true ] && echo "imgproxy" || echo "ImageMagick 7")" \
      "Image:     $([ "${build}" = true ] && echo "build a new one" || echo "keep the current one")"
    gum confirm "Deploy?" || fail "cancelled"
  fi

  connect
  local image="${REGISTRY}/${PROJECT}" site_url="https://${DOMAIN:-${MASTER_IP}}"

  # 0. other sites. Each namespace records its site (annotations typo3-kate/*).
  # A namespace with the gateway-access=public label but no annotation is from
  # before projects/ and counts as the node-IP site.
  local others owner taken
  others="$(kubectl get namespaces -o json | jq -c --arg ns "${NAMESPACE}" '
    [.items[] | {ns: .metadata.name, a: (.metadata.annotations // {}), l: (.metadata.labels // {})}
     | select(.a["typo3-kate/project"] != null or .l["gateway-access"] == "public")
     | select(.ns != $ns)
     | {ns, project: (.a["typo3-kate/project"] // "from before projects/"), domain: (.a["typo3-kate/domain"] // ""),
        nodeIPs: (.l["gateway-access"] == "public")}]')"
  owner="$(kubectl get namespace "${NAMESPACE}" -o json 2>/dev/null | jq -r '.metadata.annotations["typo3-kate/project"] // ""' || true)"
  [ -z "${owner}" ] || [ "${owner}" = "${PROJECT}" ] \
    || fail "namespace ${NAMESPACE} belongs to site ${owner}: set another namespace in projects/${PROJECT}/kate.yaml"
  if [ -n "${DOMAIN}" ]; then
    taken="$(jq -r --arg d "${DOMAIN}" '.[] | select(.domain == $d) | "\(.project) (namespace \(.ns))"' <<<"${others}")"
    [ -z "${taken}" ] || fail "${DOMAIN} is already the domain of ${taken}"
  fi
  if [ "${NODE_IPS}" = true ]; then
    taken="$(jq -r '.[] | select(.nodeIPs) | "\(.project) (namespace \(.ns))"' <<<"${others}")"
    [ -z "${taken}" ] || fail "only one site can answer on the node IPs and ${taken} does: give projects/${PROJECT}/kate.yaml a domain"
  fi

  # 1. image
  local digest
  if [ "${build}" = false ]; then
    local released
    released="$(helm -n "${NAMESPACE}" get values "${RELEASE}" -o json 2>/dev/null || echo '{}')"
    digest="$(jq -r '.image.digest // empty' <<<"${released}")"
    [ -n "${digest}" ] || fail "no deployed image yet, deploy with a build first"
    image="$(jq -r --arg i "${image}" '.image.repository // $i' <<<"${released}")"
    step "Reusing image ${image}@${digest}"
  else
    local arch tag meta
    arch="$(kubectl get nodes -o jsonpath='{.items[0].status.nodeInfo.architecture}')"
    tag="$(git -C "${ROOT}" rev-parse --short HEAD 2>/dev/null || date +%Y%m%d%H%M%S)"
    step "Building ${image}:${tag} for linux/${arch}"
    # A BuildKit builder that may push to the plain-HTTP cluster registry.
    if ! docker buildx inspect "${BUILDER}" >/dev/null 2>&1; then
      printf '[registry."%s"]\n  http = true\n  insecure = true\n' "${REGISTRY}" > "${WORK_DIR}/buildkitd.toml"
      docker buildx create --name "${BUILDER}" --driver docker-container --buildkitd-config "${WORK_DIR}/buildkitd.toml" >/dev/null
    fi
    meta="${WORK_DIR}/build-meta.json"
    docker buildx build --builder "${BUILDER}" --platform "linux/${arch}" \
      -f "${ROOT}/docker/Dockerfile" --build-arg PROJECT="${PROJECT}" \
      --build-arg PHP_VERSION="${PHP_VERSION}" --build-arg BASE_IMAGE="${BASE_IMAGE}" \
      --build-arg BASE_VARIANT="$([ "${IMGPROXY}" = true ] && echo -imgproxy || true)" -t "${image}:${tag}" \
      --push --metadata-file "${meta}" "${ROOT}"
    digest="$(jq -r '."containerimage.digest"' "${meta}")"
    [[ "${digest}" == sha256:* ]] || fail "no image digest in the build output"
    note "Pushed ${image}@${digest}"
  fi

  # 2. namespace + secrets
  step "Namespace ${NAMESPACE} (site ${PROJECT})"
  kubectl create namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f - >/dev/null
  kubectl annotate namespace "${NAMESPACE}" --overwrite \
    typo3-kate/project="${PROJECT}" typo3-kate/domain="${DOMAIN}" >/dev/null
  if [ "${NODE_IPS}" = true ]; then
    # may attach to public-gateway's https listener, which answers on the node IPs
    kubectl label namespace "${NAMESPACE}" gateway-access=public --overwrite >/dev/null
  elif [ -n "$(kubectl get namespace "${NAMESPACE}" -o jsonpath='{.metadata.labels.gateway-access}')" ]; then
    kubectl label namespace "${NAMESPACE}" gateway-access- >/dev/null
  fi

  if ! k get secret typo3-env >/dev/null 2>&1; then
    note "Creating Secrets with random passwords"
    local db_password valkey_password
    db_password="$(openssl rand -hex 24)"
    valkey_password="$(openssl rand -hex 24)"
    k create secret generic typo3-env \
      --from-literal=TYPO3_ENCRYPTION_KEY="$(openssl rand -hex 48)" \
      --from-literal=TYPO3_DB_PASSWORD="${db_password}" \
      --from-literal=TYPO3_VALKEY_PASSWORD="${valkey_password}" >/dev/null
    k create secret generic typo3-mariadb \
      --from-literal=root-password="$(openssl rand -hex 24)" \
      --from-literal=typo3-password="${db_password}" >/dev/null
    k label secret typo3-mariadb k8s.mariadb.com/watch= >/dev/null
    k create secret generic typo3-valkey --from-literal=password="${valkey_password}" >/dev/null
  fi
  # The backend login (admin.username in kate.yaml; the first install creates it)
  if ! k get secret typo3-admin >/dev/null 2>&1; then
    k create secret generic typo3-admin \
      --from-literal=username="${ADMIN_USERNAME}" \
      --from-literal=password="$(openssl rand -base64 18 | tr -d '/+=')A1." >/dev/null
  fi
  # Garage (S3): created separately, so clusters from before Garage get it too.
  if ! k get secret typo3-garage >/dev/null 2>&1; then
    note "Creating the Garage Secret"
    k create secret generic typo3-garage \
      --from-literal=rpc-secret="$(openssl rand -hex 32)" \
      --from-literal=admin-token="$(openssl rand -base64 32)" \
      --from-literal=access-key="GK$(openssl rand -hex 12)" \
      --from-literal=secret-key="$(openssl rand -hex 32)" >/dev/null
  fi
  if [ -z "$(k get secret typo3-env -o jsonpath='{.data.TYPO3_S3_KEY}')" ]; then
    note "Adding the S3 credentials to typo3-env"
    k patch secret typo3-env --type merge -p "$(jq -n \
      --arg key "$(secret_value typo3-garage access-key)" \
      --arg secret "$(secret_value typo3-garage secret-key)" \
      '{stringData: {TYPO3_S3_KEY: $key, TYPO3_S3_SECRET: $secret}}')" >/dev/null
  fi
  # imgproxy signing key and salt: always present, so imgproxy.enabled can be switched on any time
  if [ -z "$(k get secret typo3-env -o jsonpath='{.data.IMGPROXY_KEY}')" ]; then
    note "Adding the imgproxy signing key to typo3-env"
    k patch secret typo3-env --type merge -p "$(jq -n \
      --arg key "$(openssl rand -hex 64)" \
      --arg salt "$(openssl rand -hex 64)" \
      '{stringData: {IMGPROXY_KEY: $key, IMGPROXY_SALT: $salt}}')" >/dev/null
  fi
  # Mercure JWT keys: always present, so mercure.enabled can be switched on any time.
  if [ -z "$(k get secret typo3-env -o jsonpath='{.data.MERCURE_PUBLISHER_JWT_KEY}')" ]; then
    note "Adding the Mercure JWT keys to typo3-env"
    k patch secret typo3-env --type merge -p "$(jq -n \
      --arg pub "$(openssl rand -hex 32)" \
      --arg sub "$(openssl rand -hex 32)" \
      '{stringData: {MERCURE_PUBLISHER_JWT_KEY: $pub, MERCURE_SUBSCRIBER_JWT_KEY: $sub}}')" >/dev/null
  fi

  # 3. routing: Gateway, certificate, media route
  step "Routing ${DOMAIN:-(node IPs only)}"
  local route_args=() issuer="" wildcard=""
  if [ -n "${DOMAIN}" ]; then
    wildcard="$(wildcard_for "${DOMAIN}")"
    if [ -n "${wildcard}" ]; then
      # One certificate for *.<wildcard> in gateway-system, shared by the sites
      issuer="$(issuer_for "${WILDCARD_ENVIRONMENT}")"
      local wildcard_provider="${WILDCARD_PROVIDER:-$(dns_default)}"
      dns_provider_check "${wildcard_provider}" "acme.wildcard.provider"
      route_args+=(--hostname "${DOMAIN}" --certificate-ref gateway-system/wildcard-tls)
      restore_certificate gateway-system wildcard-tls "*.${wildcard}" "${issuer}" "wildcard.${wildcard}" \
        || warn_new_production "${issuer}" gateway-system wildcard-tls "*.${wildcard}" "acme.wildcard.environment in ./kate.yaml"
      wildcard_manifests "${wildcard}" "${issuer}" "${wildcard_provider}" | kubectl apply -f - >/dev/null
      grant_manifest "${NAMESPACE}" | kubectl apply -f - >/dev/null
    else
      issuer="$(issuer_for "${ACME_ENVIRONMENT}")"
      local provider="${ACME_PROVIDER:-$(dns_default)}"
      dns_provider_check "${provider}" "acme.provider in projects/${PROJECT}/kate.yaml"
      route_args+=(--hostname "${DOMAIN}" --issuer "${issuer}" --dns-provider "${provider}")
      # Before the Certificate exists: a saved copy spares a new order
      restore_certificate "${NAMESPACE}" site-tls "${DOMAIN}" "${issuer}" "${DOMAIN}" \
        || warn_new_production "${issuer}" "${NAMESPACE}" site-tls "${DOMAIN}" "acme.environment in projects/${PROJECT}/kate.yaml"
      kubectl -n gateway-system delete referencegrant "site-${NAMESPACE}" --ignore-not-found >/dev/null
    fi
  fi
  [ "${NODE_IPS}" = false ] || route_args+=(--node-ips)
  cmd_manifests ${route_args[@]+"${route_args[@]}"} | k apply -f - >/dev/null
  if [ -n "${wildcard}" ]; then
    # DNS-01 takes a few minutes the first time (TXT record, propagation)
    wait_for "Let's Encrypt certificate for *.${wildcard} (DNS-01, a few minutes the first time)" \
      "$0" __wait-certificate gateway-system wildcard \
      || certificate_failed gateway-system wildcard "*.${wildcard}" "acme.wildcard.environment in ./kate.yaml"
    save_certificate gateway-system wildcard-tls "wildcard.${wildcard}"
    wait_for "Gateway" kubectl -n "${NAMESPACE}" wait gateway/site --for=condition=Programmed --timeout=2m
    # The site's own certificate from before the wildcard: keep a copy, then drop it
    if k get certificate site >/dev/null 2>&1; then
      save_certificate "${NAMESPACE}" site-tls "${DOMAIN}"
      k delete certificate site >/dev/null
      k delete secret site-tls --ignore-not-found >/dev/null
      note "The site now uses *.${wildcard}; its own certificate is saved in ${CERT_DIR}"
    fi
  elif [ -n "${DOMAIN}" ]; then
    wait_for "Let's Encrypt certificate for ${DOMAIN} (DNS-01, a few minutes the first time)" \
      "$0" __wait-certificate "${NAMESPACE}" site \
      || certificate_failed "${NAMESPACE}" site "${DOMAIN}" "acme.environment in projects/${PROJECT}/kate.yaml"
    save_certificate "${NAMESPACE}" site-tls "${DOMAIN}"
    wait_for "Gateway" kubectl -n "${NAMESPACE}" wait gateway/site --for=condition=Programmed --timeout=2m
  fi

  # 4. platform
  step "MariaDB, Valkey, Garage, volumes"
  k apply -f "${ROOT}/k8s/platform/" >/dev/null
  # Replaced by networkPolicy.extraEgress: alone it cut a new release's
  # migrations Job off from DNS (the chart's policy comes after the hook)
  k delete networkpolicy typo3-to-garage --ignore-not-found >/dev/null
  wait_for "MariaDB" kubectl -n "${NAMESPACE}" wait mariadb/typo3-mariadb --for=condition=Ready --timeout=10m
  wait_for "database, user, grant" kubectl -n "${NAMESPACE}" wait database/typo3 user/typo3 grant/typo3 --for=condition=Ready --timeout=5m
  wait_for "Valkey" kubectl -n "${NAMESPACE}" rollout status statefulset/typo3-valkey --timeout=5m
  wait_for "Valkey cache" kubectl -n "${NAMESPACE}" rollout status deployment/typo3-valkey-cache --timeout=5m
  wait_for "Garage" kubectl -n "${NAMESPACE}" rollout status statefulset/garage --timeout=5m
  # The default bucket exists; serving it anonymously is a separate switch.
  k exec garage-0 -- /garage bucket website --allow media >/dev/null
  wait_for "volumes" kubectl -n "${NAMESPACE}" wait pvc/typo3-fileadmin pvc/typo3-typo3temp-assets \
    --for=jsonpath='{.status.phase}'=Bound --timeout=5m

  # 5. first install
  mariadb_root() {
    k exec -i typo3-mariadb-0 -c mariadb -- \
      mariadb -uroot -p"$(secret_value typo3-mariadb root-password)" typo3 "$@"
  }
  local first_install=false
  local admin_in_secret
  admin_in_secret="$(secret_value typo3-admin username)"
  if [ -z "$(mariadb_root -N -e "SHOW TABLES LIKE 'be_users'")" ]; then
    first_install=true
    step "Empty database: installing TYPO3"
    # Not installed yet, so admin.username may still change (e.g. after a
    # deploy that stopped before this step)
    if [ "${admin_in_secret}" != "${ADMIN_USERNAME}" ]; then
      k patch secret typo3-admin --type merge -p "$(jq -nc --arg u "${ADMIN_USERNAME}" '{stringData: {username: $u}}')" >/dev/null
      note "Backend user: ${ADMIN_USERNAME} (was ${admin_in_secret} in the Secret)"
    fi
    # Same image as the release. `typo3 setup` writes settings.php, which is
    # root-owned in the image: give it a writable copy of config/system without
    # settings.php (thrown away with the pod; the image keeps its own).
    k delete pod typo3-install --ignore-not-found >/dev/null
    cat <<YAML | k apply -f - >/dev/null
apiVersion: v1
kind: Pod
metadata:
  name: typo3-install
spec:
  restartPolicy: Never
  automountServiceAccountToken: false
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
  volumes:
    - name: config-system
      emptyDir: {}
  initContainers:
    - name: copy-config
      image: ${image}@${digest}
      command: ["sh", "-c", "cp /app/config/system/* /config-system/ && rm /config-system/settings.php"]
      volumeMounts:
        - {name: config-system, mountPath: /config-system}
  containers:
    - name: setup
      image: ${image}@${digest}
      volumeMounts:
        - {name: config-system, mountPath: /app/config/system}
      command:
        - sh
        - -c
        - >-
          vendor/bin/typo3 setup --no-interaction --force --server-type=other
          --driver=mysqli --host=typo3-mariadb --port=3306 --dbname=typo3 --username=typo3
          --password="\$TYPO3_DB_PASSWORD"
          --admin-username="\$ADMIN_USERNAME" --admin-user-password="\$ADMIN_PASSWORD"
          --admin-email="${ADMIN_EMAIL}" --project-name="${PROJECT}"
      envFrom:
        - secretRef:
            name: typo3-env
      env:
        - name: TYPO3_DB_HOST
          value: typo3-mariadb
        - name: ADMIN_USERNAME
          valueFrom:
            secretKeyRef: {name: typo3-admin, key: username}
        - name: ADMIN_PASSWORD
          valueFrom:
            secretKeyRef: {name: typo3-admin, key: password}
YAML
    local phase="" _
    note "Waiting for typo3 setup (up to 10 minutes)"
    for _ in $(seq 1 120); do
      phase="$(k get pod typo3-install -o jsonpath='{.status.phase}')"
      [[ "${phase}" == Succeeded || "${phase}" == Failed ]] && break
      sleep 5
    done
    if [ "${phase}" != Succeeded ]; then
      k logs typo3-install --all-containers --tail=40 >&2 || true
      fail "typo3 setup ${phase:-did not finish} (pod typo3-install kept for inspection)"
    fi
    k logs typo3-install | grep -vE '"level":"(debug|info|notice)"' | tail -5 >&2
    k delete pod typo3-install >/dev/null
    mariadb_root < "${ROOT}/k8s/bootstrap.sql"
    note "Root page, About and Contact created"
  elif [ "${admin_in_secret}" != "${ADMIN_USERNAME}" ]; then
    note "admin.username ${ADMIN_USERNAME} only applies to a new install: this site's backend user stays ${admin_in_secret}"
  fi

  # 6. helm
  step "Helm release ${RELEASE}"
  local values_args=("${site_url}")
  [ -z "${DOMAIN}" ] || values_args+=(--hostname "${DOMAIN}")
  [ "${NODE_IPS}" = false ] || values_args+=(--node-ips)
  cmd_values "${values_args[@]}" > "${WORK_DIR}/site.yaml"
  local imgproxy_args=()
  if [ "${IMGPROXY}" = true ]; then
    # Originals come through the site's domain: resolve it to Traefik in the
    # cluster. A staging certificate isn't trusted, so don't verify it then.
    coredns_set "${NAMESPACE}" "${DOMAIN}"
    local environment="${ACME_ENVIRONMENT}"
    [ -z "$(wildcard_for "${DOMAIN}")" ] || environment="${WILDCARD_ENVIRONMENT}"
    imgproxy_args=(--set imgproxy.enabled=true --set "imgproxy.ignoreSslVerification=$([ "${environment}" = staging ] && echo true || echo false)")
  else
    coredns_unset "${NAMESPACE}"
  fi
  helm_values() { if [ -f "$1" ]; then yq '.helm // {}' "$1"; else echo "{}"; fi; }
  helm_values "${KATE_FILE}" > "${WORK_DIR}/cluster-kate.yaml"
  helm_values "${PROJECT_FILE}" > "${WORK_DIR}/project-kate.yaml"
  wait_for "helm upgrade (migrations first, then the rollout)" \
    helm upgrade --install "${RELEASE}" "${ROOT}/k8s/charts/typo3" \
      --namespace "${NAMESPACE}" \
      -f "${ROOT}/k8s/values/cluster.yaml" \
      -f "${WORK_DIR}/cluster-kate.yaml" \
      -f "${WORK_DIR}/site.yaml" \
      -f "${WORK_DIR}/project-kate.yaml" \
      --set image.repository="${image}" \
      --set image.digest="${digest}" \
      ${imgproxy_args[@]+"${imgproxy_args[@]}"} \
      --wait --timeout 15m
  if [ "${first_install}" = true ]; then
    k exec deploy/"${RELEASE}"-backend -- vendor/bin/typo3 cache:flush >/dev/null   # caches in Valkey are shared
  fi

  # Switched between ImageMagick and imgproxy: the processed images of the old
  # way stay in use until they're gone, so remove them (the new pods run now).
  # The first deploy only records the way.
  local images previous
  images="$([ "${IMGPROXY}" = true ] && echo imgproxy || echo imagemagick)"
  previous="$(kubectl get namespace "${NAMESPACE}" -o json | jq -r '.metadata.annotations["typo3-kate/images"] // ""')"
  if [ -n "${previous}" ] && [ "${previous}" != "${images}" ]; then
    step "Images: ${previous} -> ${images}, processing them again"
    reprocess_site
  fi
  kubectl annotate namespace "${NAMESPACE}" --overwrite typo3-kate/images="${images}" >/dev/null

  # summary
  echo >&2
  k get pods -o wide >&2
  local where="${site_url}/"
  [ "${NODE_IPS}" = false ] || [ -z "${DOMAIN}" ] || where="${where}   (every node IP works too; trust infra/cluster-ca.crt for those)"
  echo >&2
  gum style --border rounded --padding "0 1" >&2 \
    "TYPO3:    ${where}" \
    "Backend:  ${site_url}/typo3   user: $(secret_value typo3-admin username)" \
    "Password: ./kate password ${PROJECT}   (--copy: to the clipboard)"
}

# --- certificates kept across rebuilds --------------------------------------------------
# Let's Encrypt issues at most 5 certificates per week for the same domain,
# without exceptions. A rebuilt cluster or a removed namespace would order a
# new one each time, so ./kate keeps a copy of every issued certificate on
# this machine and restores it into a fresh namespace. cert-manager then sees
# a matching, valid certificate (same domain, same issuer) and orders nothing.
CERT_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/typo3-kate/certificates"
# cert_file <name> <issuer>: the copy of a site's certificate (<name> = its
# domain) or of the wildcard one (<name> = wildcard.<domain>)
cert_file() { echo "${CERT_DIR}/$1.$2.json"; }

# save_certificate <namespace> <secret> <name>: copy the Secret (with the
# private key, so only readable by you)
save_certificate() {
  local namespace="$1" secret="$2" name="$3" json issuer
  json="$(kubectl -n "${namespace}" get secret "${secret}" -o json 2>/dev/null)" || return 0
  issuer="$(jq -r '.metadata.annotations["cert-manager.io/issuer-name"] // ""' <<<"${json}")"
  [ -n "${issuer}" ] || return 0
  mkdir -p "${CERT_DIR}"
  chmod 700 "${CERT_DIR}"
  (umask 077 && jq '{apiVersion, kind, type, data,
      metadata: {name: .metadata.name, labels: (.metadata.labels // {}),
        annotations: ((.metadata.annotations // {}) | with_entries(select(.key | startswith("cert-manager.io/"))))}}' \
      <<<"${json}" > "$(cert_file "${name}" "${issuer}")")
}

# restore_certificate <namespace> <secret> <dns-name> <issuer> <name>: the
# saved copy, if the namespace has no such Secret yet, the copy contains
# exactly this DNS name and stays valid for 7 days. 0 = restored.
restore_certificate() {
  local namespace="$1" secret="$2" dns_name="$3" issuer="$4" name="$5" file crt
  file="$(cert_file "${name}" "${issuer}")"
  [ -f "${file}" ] || return 1
  ! kubectl -n "${namespace}" get secret "${secret}" >/dev/null 2>&1 || return 1
  crt="$(jq -r '.data["tls.crt"]' "${file}" | base64 -d)"
  openssl x509 -noout -checkend 604800 <<<"${crt}" >/dev/null 2>&1 || return 1
  openssl x509 -noout -text <<<"${crt}" | grep -o 'DNS:[^,]*' | sed 's/^DNS://' | grep -qxF -- "${dns_name}" || return 1
  kubectl -n "${namespace}" apply -f "${file}" >/dev/null
  note "Restored the saved certificate for ${dns_name} (valid until $(openssl x509 -noout -enddate <<<"${crt}" | cut -d= -f2)), nothing is ordered"
}

# --- wildcard certificate ----------------------------------------------------------------
# acme.wildcard in ./kate.yaml: one certificate for *.<domain> in gateway-system,
# used by every site whose domain is exactly one level below it. Each such
# site's Gateway refers to it, allowed by a ReferenceGrant "site-<namespace>".
WILDCARD_DOMAIN=""
WILDCARD_ENVIRONMENT=staging
WILDCARD_PROVIDER=""
if [ -f "${KATE_FILE}" ] && command -v yq >/dev/null; then
  WILDCARD_DOMAIN="$(yq -r '.acme.wildcard.domain // ""' "${KATE_FILE}")"
  WILDCARD_ENVIRONMENT="$(yq -r '.acme.wildcard.environment // "staging"' "${KATE_FILE}")"
  WILDCARD_PROVIDER="$(yq -r '.acme.wildcard.provider // ""' "${KATE_FILE}")"
fi

# --- DNS providers ----------------------------------------------------------------------
# acme.providers in ./kate.yaml, rendered into the ClusterIssuers by infra/dns.tf.
# A Certificate labelled typo3-kate/dns-provider=<name> uses that provider; the
# default one (same rule as dns.tf) also takes Certificates without a label.
# dns_providers: their names
dns_providers() {
  [ -f "${KATE_FILE}" ] || return 0
  yq -r '(.acme.providers // {}) | keys | .[]' "${KATE_FILE}" | sort -u
}
# dns_default: acme.defaultProvider, else hetzner, else the only one, else
# hetzner (no ./kate.yaml on this machine)
dns_default() {
  local names configured=""
  names="$(dns_providers)"
  [ ! -f "${KATE_FILE}" ] || configured="$(yq -r '.acme.defaultProvider // ""' "${KATE_FILE}")"
  if [ -n "${configured}" ]; then echo "${configured}"
  elif grep -qx hetzner <<<"${names}" || [ -z "${names}" ]; then echo hetzner
  elif [ "$(wc -l <<<"${names}" | tr -d ' ')" -eq 1 ]; then echo "${names}"
  else fail "several DNS providers in ./kate.yaml and no acme.defaultProvider: set one, or acme.provider in each site"
  fi
}
# dns_provider_check <name> <where it is set>: fail unless ./kate.yaml defines it
dns_provider_check() {
  local names
  # empty: dns_default failed inside $(...), which only ends that subshell
  [ -n "$1" ] || fail "several DNS providers in ./kate.yaml and no acme.defaultProvider: set one, or $2"
  [[ "$1" =~ ^[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$ ]] \
    || fail "DNS provider name '$1' ($2): letters, digits and - _ . only (it becomes a Kubernetes label)"
  names="$(dns_providers)"
  [ -z "${names}" ] || grep -qxF -- "$1" <<<"${names}" \
    || fail "DNS provider $1 ($2) is not in acme.providers of ./kate.yaml: $(tr '\n' ' ' <<<"${names}")"
}
# dns_provider_type <name>: its type (acme.providers.<name>.type)
dns_provider_type() {
  local type=""
  [ ! -f "${KATE_FILE}" ] || type="$(NAME="$1" yq -r '.acme.providers[strenv(NAME)].type // ""' "${KATE_FILE}")"
  [ -n "${type}" ] || [ "$1" != hetzner ] || type=hetzner
  echo "${type}"
}

issuer_for() { if [ "$1" = production ]; then echo letsencrypt; else echo letsencrypt-staging; fi; }

# wildcard_for <domain>: the wildcard domain that covers it, or nothing
wildcard_for() {
  [ -n "${WILDCARD_DOMAIN}" ] || return 0
  [[ "$1" == *".${WILDCARD_DOMAIN}" ]] || return 0
  local label="${1%".${WILDCARD_DOMAIN}"}"
  [[ "${label}" != *.* ]] && [ -n "${label}" ] && echo "${WILDCARD_DOMAIN}"
  return 0
}

wildcard_manifests() {   # <wildcard domain> <issuer> <dns provider>
  cat <<YAML
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: wildcard
  namespace: gateway-system
  labels:
    typo3-kate/dns-provider: $3
spec:
  secretName: wildcard-tls
  dnsNames:
    - "*.$1"
  issuerRef:
    kind: ClusterIssuer
    name: $2
YAML
}

grant_manifest() {   # <site namespace>: its Gateway may use wildcard-tls
  cat <<YAML
apiVersion: gateway.networking.k8s.io/v1beta1
kind: ReferenceGrant
metadata:
  name: site-$1
  namespace: gateway-system
spec:
  from:
    - group: gateway.networking.k8s.io
      kind: Gateway
      namespace: $1
  to:
    - group: ""
      kind: Secret
      name: wildcard-tls
YAML
}

# warn_new_production <issuer> <namespace> <secret> <dns-name> <setting>:
# when a production certificate is about to be ordered
warn_new_production() {
  [ "$1" = letsencrypt ] || return 0
  ! kubectl -n "$2" get secret "$3" >/dev/null 2>&1 || return 0
  gum style --foreground 214 >&2 \
    "Ordering a new production certificate for $4: Let's Encrypt allows 5 per week for the same names." \
    "While you rebuild or experiment, set $5 to staging."
}

# --- dns: the wildcard DNS record ------------------------------------------------------
# An A record *.<acme.wildcard.domain> at Hetzner DNS (Cloud API, with the
# token of the wildcard's provider in acme.providers), so a new site under
# the wildcard needs no DNS step. Records of single names still win over it.
HCLOUD_API=https://api.hetzner.cloud/v1

# dns_token <provider>: acme.providers.<name>.token in ./kate.yaml, else the
# cluster's copy (Secret dns-<name>; "hetzner" on clusters from before)
dns_token() {
  local token=""
  [ ! -f "${KATE_FILE}" ] || token="$(NAME="$1" yq -r '.acme.providers[strenv(NAME)].token // ""' "${KATE_FILE}")"
  if [ -z "${token}" ]; then
    connect
    local secret
    for secret in "dns-$1" hetzner; do
      token="$(kubectl -n cert-manager get secret "${secret}" -o jsonpath='{.data.token}' 2>/dev/null | base64 -d || true)"
      [ -z "${token}" ] || break
    done
  fi
  [ -n "${token}" ] || fail "no Hetzner DNS token for provider $1: acme.providers.$1.token in ./kate.yaml"
  echo "${token}"
}

# hcloud <method> <path> [<json body>]: the response body; fails on HTTP errors
# except 404, which prints nothing
hcloud() {
  local method="$1" path="$2" body="${3:-}" out code
  out="$(mktemp)"
  code="$(curl -gsS -o "${out}" -w '%{http_code}' -X "${method}" \
    -H "Authorization: Bearer ${DNS_TOKEN}" -H "Content-Type: application/json" \
    ${body:+--data "${body}"} "${HCLOUD_API}${path}")" || { rm -f "${out}"; fail "Hetzner API not reachable"; }
  if [ "${code}" = 404 ]; then rm -f "${out}"; return 0; fi
  if [ "${code}" -ge 300 ]; then
    local message
    message="$(jq -r '.error.message // empty' "${out}" 2>/dev/null || true)"
    rm -f "${out}"
    fail "Hetzner API ${method} ${path}: HTTP ${code} ${message}"
  fi
  cat "${out}"
  rm -f "${out}"
}

cmd_dns() {
  local usage="Usage: ./kate dns [--ip <ipv4>] [--ttl <seconds>] [--yes]"
  local ip="" ttl=300 yes=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --ip) [ $# -ge 2 ] || fail "${usage}"; ip="$2"; shift 2 ;;
      --ttl) [ $# -ge 2 ] || fail "${usage}"; ttl="$2"; shift 2 ;;
      --yes) yes=true; shift ;;
      *) fail "${usage}" ;;
    esac
  done
  need curl jq yq
  [ -n "${WILDCARD_DOMAIN}" ] || fail "no acme.wildcard.domain in ./kate.yaml: the record is *.<that domain>"
  [[ "${ttl}" =~ ^[0-9]+$ ]] || fail "--ttl takes seconds"
  local provider="${WILDCARD_PROVIDER:-$(dns_default)}"
  dns_provider_check "${provider}" "acme.wildcard.provider"
  local type
  type="$(dns_provider_type "${provider}")"
  [ "${type}" = hetzner ] \
    || fail "./kate dns only talks to Hetzner DNS; the wildcard's provider ${provider} is ${type:-unknown}: create the A record *.${WILDCARD_DOMAIN} at your DNS provider"
  DNS_TOKEN="$(dns_token "${provider}")"

  # The zone: the wildcard domain itself or the nearest parent Hetzner has
  local zone="${WILDCARD_DOMAIN}" name="*"
  while [ -z "$(hcloud GET "/zones/${zone}")" ]; do
    [[ "${zone}" == *.*.* ]] || fail "no Hetzner DNS zone for ${WILDCARD_DOMAIN} (or a parent) that this token can see"
    name="${name}.${zone%%.*}"
    zone="${zone#*.}"
  done

  if [ -z "${ip}" ]; then
    # An existing site under the wildcard already points at the right address
    local p suggestion=""
    for p in $(list_projects); do
      load_project "${p}"
      [ -n "$(wildcard_for "${DOMAIN}")" ] || continue
      suggestion="$( (dig +short A "${DOMAIN}" 2>/dev/null || true) | grep -E '^[0-9.]+$' | head -1 || true)"
      [ -z "${suggestion}" ] || { note "${DOMAIN} points at ${suggestion}"; break; }
    done
    if [ -z "${suggestion}" ]; then
      suggestion="$(curl -fsS --max-time 5 https://api.ipify.org 2>/dev/null || true)"
      [ -z "${suggestion}" ] || note "This machine's public IPv4 address: ${suggestion} (from api.ipify.org)"
    fi
    if interactive; then
      ip="$(gum input --header "IPv4 address for *.${WILDCARD_DOMAIN} (your router's public address)" --value "${suggestion}")"
    else
      ip="${suggestion}"
    fi
  fi
  [[ "${ip}" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || fail "--ip needs an IPv4 address (got: ${ip:-nothing})"

  local current
  current="$(hcloud GET "/zones/${zone}/rrsets/${name}/A" | jq -r '[.rrset.records[]?.value] | join(", ")')"
  if [ "${current}" = "${ip}" ]; then
    note "*.${WILDCARD_DOMAIN} already points at ${ip}"
    return
  fi
  gum style --border rounded --padding "0 1" >&2 \
    "Record:  ${name}.${zone} A (zone ${zone})" \
    "Now:     ${current:-(none)}" \
    "New:     ${ip}   TTL ${ttl}s"
  if [ "${yes}" = false ]; then
    interactive || fail "missing --yes: pass it to change DNS without asking"
    gum confirm "Set it?" || fail "cancelled, nothing changed"
  fi

  local records
  records="$(jq -nc --arg ip "${ip}" '[{value: $ip, comment: "typo3-kate: ./kate dns"}]')"
  if [ -z "${current}" ]; then
    hcloud POST "/zones/${zone}/rrsets" "$(jq -nc --arg n "${name}" --argjson t "${ttl}" --argjson r "${records}" \
      '{name: $n, type: "A", ttl: $t, records: $r}')" >/dev/null
  else
    hcloud POST "/zones/${zone}/rrsets/${name}/A/actions/set_records" "$(jq -nc --argjson r "${records}" '{records: $r}')" >/dev/null
  fi
  # The change runs as an action: wait until the record reads back
  local _
  for _ in $(seq 1 15); do
    current="$(hcloud GET "/zones/${zone}/rrsets/${name}/A" | jq -r '[.rrset.records[]?.value] | join(", ")')"
    [ "${current}" != "${ip}" ] || { step "*.${WILDCARD_DOMAIN} -> ${ip}"; note "Single-name records (e.g. kate.${WILDCARD_DOMAIN}) still take precedence; resolvers may cache the old answer for up to its TTL."; return; }
    sleep 2
  done
  fail "the record doesn't read back as ${ip} yet: check it in the Hetzner Console"
}

# --- certificates: the saved copies ------------------------------------------------------
# epoch <date from openssl -enddate>: seconds since 1970 (GNU and BSD date)
epoch() { date -d "$1" +%s 2>/dev/null || date -j -f "%b %e %H:%M:%S %Y %Z" "$1" +%s; }

cmd_certificates() {
  [ $# -eq 0 ] || fail "Usage: ./kate certificates"
  need jq openssl
  local files=() file
  for file in "${CERT_DIR}"/*.json; do
    [ -f "${file}" ] && files+=("${file}")
  done
  if [ ${#files[@]} -eq 0 ]; then
    note "No saved certificates in ${CERT_DIR} yet: ./kate deploy saves each issued one."
    return
  fi
  local rows=() name domain issuer environment crt end days state now
  now="$(date +%s)"
  for file in "${files[@]}"; do
    name="$(basename "${file}" .json)"
    case "${name}" in
      *.letsencrypt-staging) issuer=letsencrypt-staging; environment=staging ;;
      *.letsencrypt) issuer=letsencrypt; environment=production ;;
      *) continue ;;
    esac
    domain="${name%."${issuer}"}"
    [[ "${domain}" != wildcard.* ]] || domain="*.${domain#wildcard.}"
    crt="$(jq -r '.data["tls.crt"] // empty' "${file}" 2>/dev/null | base64 -d 2>/dev/null || true)"
    end="$(openssl x509 -noout -enddate <<<"${crt}" 2>/dev/null | cut -d= -f2 || true)"
    if [ -z "${end}" ]; then
      rows+=("${domain},${environment},-,-,unreadable")
      continue
    fi
    days=$(( ($(epoch "${end}") - now) / 86400 ))
    if ! openssl x509 -noout -checkend 0 <<<"${crt}" >/dev/null; then
      state="expired"
    elif ! openssl x509 -noout -checkend 604800 <<<"${crt}" >/dev/null; then
      state="expires soon: not restored"
    else
      state="restored on deploy"
    fi
    rows+=("${domain},${environment},${end},${days},${state}")
  done
  printf '%s\n' "${rows[@]}" | gum table --print --separator "," --columns "Domain,Environment,Valid until,Days left,State"
  note "In ${CERT_DIR}"
}

# certificate_failed <namespace> <certificate> <dns-name> <where to switch>:
# why the Certificate isn't Ready, then fail
certificate_failed() {
  local namespace="$1" certificate="$2" dns_name="$3" setting="$4" described
  described="$(kubectl -n "${namespace}" describe certificate "${certificate}" 2>/dev/null || true)"
  tail -15 <<<"${described}" >&2
  kubectl get challenges -n "${namespace}" -o wide >&2 2>/dev/null || true
  # After a failed attempt cert-manager waits (1 h and more) before it tries again
  local retry="after fixing the cause: kubectl -n ${namespace} delete certificate ${certificate} && ./kate deploy ${PROJECT}"
  if grep -q "rateLimited" <<<"${described}"; then
    local until
    until="$(grep -o 'retry after [0-9-]* [0-9:]* UTC' <<<"${described}" | tail -1)"
    fail "Let's Encrypt rate limit for ${dns_name} (${until:-retry later}): too many certificates for it this week. Until then reuse an existing certificate or set ${setting} to staging; ${retry}"
  fi
  fail "no certificate for ${dns_name}, see the events above. For DNS-01 the domain must be in a Hetzner DNS zone that the token in ./kate.yaml may edit; ${retry}"
}

# __wait-certificate <namespace> [<certificate>]: until it is Ready (0), or an
# issuance attempt has failed (1): cert-manager then backs off for an hour or
# more, so waiting longer is pointless. At most 10 minutes.
cmd_wait_certificate() {
  local namespace="$1" certificate="${2:-site}" status _
  for _ in $(seq 1 60); do
    status="$(kubectl -n "${namespace}" get certificate "${certificate}" -o json 2>/dev/null | jq -r '
      if ([.status.conditions[]? | select(.type == "Ready" and .status == "True")] | length) > 0 then "ready"
      elif (.status.failedIssuanceAttempts // 0) > 0 and ([.status.conditions[]? | select(.type == "Issuing" and .status == "True")] | length) == 0 then "failed"
      else "waiting" end' || echo waiting)"
    case "${status}" in
      ready) return 0 ;;
      failed) return 1 ;;
    esac
    sleep 10
  done
  return 1
}

# --- new: create a site in projects/<site>/ ------------------------------------------
cmd_new() {
  local name="" domain="" domain_set=false acme="" namespace="" node_ips=false from="" php=""
  local usage="Usage: ./kate new [<site>] [--domain <domain>] [--acme staging|production] [--namespace <ns>] [--php <version>] [--node-ips] [--from <site>]"
  while [ $# -gt 0 ]; do
    case "$1" in
      --domain) [ $# -ge 2 ] || fail "${usage}"; domain="$2"; domain_set=true; shift 2 ;;
      --acme) [ $# -ge 2 ] || fail "${usage}"; acme="$2"; shift 2 ;;
      --namespace) [ $# -ge 2 ] || fail "${usage}"; namespace="$2"; shift 2 ;;
      --node-ips) node_ips=true; shift ;;
      --from) [ $# -ge 2 ] || fail "${usage}"; from="$2"; shift 2 ;;
      --php) [ $# -ge 2 ] || fail "${usage}"; php="$2"; shift 2 ;;
      -*) fail "${usage}" ;;
      *) [ -z "${name}" ] || fail "${usage}"; name="$1"; shift ;;
    esac
  done
  need yq

  if [ -z "${name}" ]; then
    name="$(ask_input "<site>" "Name of the new site (folder, image and default namespace)" "" "shop")"
  fi
  valid_name "${name}" || fail "site name '${name}': lowercase letters, digits and dashes only"
  [ ! -e "${ROOT}/projects/${name}" ] || fail "projects/${name} exists already"

  local projects
  projects="$(list_projects)"
  [ -n "${projects}" ] || fail "no site to copy composer.json and config/sites from"
  if [ -z "${from}" ]; then
    if [ "$(wc -l <<<"${projects}" | tr -d ' ')" -eq 1 ]; then
      from="${projects}"
    else
      # shellcheck disable=SC2086 # one site per line
      from="$(ask_choose "--from" "Copy composer.json and config/sites from which site?" ${projects})"
    fi
  fi
  [ -f "${ROOT}/projects/${from}/composer.json" ] || fail "no projects/${from}/composer.json"

  if [ "${domain_set}" = false ]; then
    domain="$(ask_input "--domain" "Domain (empty: answer on the node IPs instead, one site only)" "" "${name}.example.com")"
  fi
  if [ -n "${domain}" ] && [ -z "${acme}" ]; then
    # staging by default: production allows 5 certificates per week for a domain
    if interactive; then
      acme="$(gum choose --header "Let's Encrypt environment for ${domain} (production: 5 certificates per week for it, staging while you try things out)" \
        --selected staging staging production)"
    else
      acme=staging
      note "Let's Encrypt staging (untrusted test certificates); --acme production for real ones"
    fi
  fi
  acme="${acme:-staging}"
  [[ "${acme}" == staging || "${acme}" == production ]] || fail "--acme must be staging or production"
  if [ -z "${namespace}" ]; then
    if interactive; then
      namespace="$(gum input --header "Kubernetes namespace" --value "${name}")"
    else
      namespace="${name}"
    fi
  fi
  valid_name "${namespace}" || fail "namespace '${namespace}': lowercase letters, digits and dashes only"
  if [ -z "${php}" ]; then
    if interactive; then
      # shellcheck disable=SC2086 # one version per word
      php="$(gum choose --header "PHP version" --selected "${PHP_VERSIONS%% *}" ${PHP_VERSIONS})"
    else
      php="${PHP_VERSIONS%% *}"
    fi
  fi
  php_supported "${php}" || fail "--php: one of ${PHP_VERSIONS}"

  local dir="${ROOT}/projects/${name}"
  mkdir -p "${dir}/config"
  cp "${ROOT}/projects/${from}/composer.json" "${dir}/"
  # packages/ for the site's own extensions (e.g. its site package), found
  # through the path repository packages/*: ./kate composer <site> require <name>:@dev
  mkdir -p "${dir}/packages"
  touch "${dir}/packages/.gitkeep"
  local repository_added=false
  if ! jq -e '(.repositories // []) | map(select(.url == "packages/*")) | length > 0' "${dir}/composer.json" >/dev/null; then
    jq --indent 4 '.repositories = ((.repositories // []) + [{"type": "path", "url": "packages/*"}])' \
      "${dir}/composer.json" > "${dir}/composer.json.new"
    mv "${dir}/composer.json.new" "${dir}/composer.json"
    repository_added=true
  fi
  [ ! -f "${ROOT}/projects/${from}/composer.lock" ] || cp "${ROOT}/projects/${from}/composer.lock" "${dir}/"
  # The lock file's hash covers composer.json, repositories included. --no-scripts:
  # no TYPO3 plugin code runs, so the host's PHP version doesn't matter here
  if [ "${repository_added}" = true ] && [ -f "${dir}/composer.lock" ]; then
    if command -v composer >/dev/null; then
      (cd "${dir}" && composer update --lock --no-install --no-interaction --no-scripts --ignore-platform-reqs -q 2>/dev/null) \
        || note "composer.lock is out of date: ./kate composer ${name} update --lock"
    else
      note "composer.lock is out of date (no composer here): ./kate composer ${name} update --lock"
    fi
  fi
  cp -R "${ROOT}/projects/${from}/config/sites" "${dir}/config/"
  cp "${ROOT}/projects/_example/kate.yaml" "${dir}/kate.yaml"
  DOMAIN="${domain}" ACME="${acme}" yq -i '.domain = strenv(DOMAIN) | .acme.environment = strenv(ACME)' "${dir}/kate.yaml"
  [ "${namespace}" = "${name}" ] || NS="${namespace}" yq -i '.namespace = strenv(NS)' "${dir}/kate.yaml"
  [ "${node_ips}" = false ] || yq -i '.nodeIPs = true' "${dir}/kate.yaml"
  PHP="${php}" yq -i '.php = strenv(PHP)' "${dir}/kate.yaml"

  step "Created projects/${name}"
  note "From projects/${from}: composer.json, composer.lock, config/sites/. Settings: projects/${name}/kate.yaml"
  note "Own extensions go into projects/${name}/packages/<name>/, then: ./kate composer ${name} require <vendor/name>:@dev"
  [ -z "${domain}" ] || note "Before deploying: an A record for ${domain} (and the zone in Hetzner DNS for the certificate)"
  note "Deploy: ./kate deploy ${name}"
}

# --- status: the sites and what runs of them -----------------------------------------
cmd_status() {
  need kubectl helm jq yq tofu
  connect
  local rows=() p state cert pods garage
  for p in $(list_projects); do
    load_project "${p}"
    if ! kubectl get namespace "${NAMESPACE}" >/dev/null 2>&1; then
      rows+=("${PROJECT},${NAMESPACE},${DOMAIN:-node IPs},not deployed,-,-,-")
      continue
    fi
    state="$(helm -n "${NAMESPACE}" status "${RELEASE}" -o json 2>/dev/null | jq -r '.info.status // "no release"' || echo "no release")"
    cert="-"
    if [ -n "$(wildcard_for "${DOMAIN}")" ]; then
      cert="$(kubectl -n gateway-system get certificate wildcard -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || true) (*.${WILDCARD_DOMAIN})"
    elif [ -n "${DOMAIN}" ]; then
      cert="$(kubectl -n "${NAMESPACE}" get certificate site -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || true)"
    fi
    pods="$(kubectl -n "${NAMESPACE}" get pods -o json | jq -r '
      [.items[] | select(.status.phase != "Succeeded")] as $p
      | "\([$p[] | select(all(.status.containerStatuses[]?; .ready))] | length)/\($p | length) ready"')"
    garage="-"
    if kubectl -n "${NAMESPACE}" get pod garage-0 >/dev/null 2>&1; then
      garage=":$(garage_port "${NAMESPACE}")/ui/"
    fi
    rows+=("${PROJECT},${NAMESPACE},${DOMAIN:-node IPs},${state},${cert:-?},${pods},${garage}")
  done
  printf '%s\n' "${rows[@]}" | gum table --print --separator "," --columns "Site,Namespace,Domain,Release,Certificate,Pods,Garage UI"
  note "Garage UI: ./kate garage <site> opens it on the site's port, with the token"
}

# --- in-cluster DNS for imgproxy -------------------------------------------------------
# A site's domain resolves to k3s' Traefik inside the cluster, so imgproxy
# fetches originals through the site's own Gateway and certificate, without
# going out to the router and back. k3s' CoreDNS imports every *.override key
# of the ConfigMap kube-system/coredns-custom and reloads by itself.
coredns_key() { echo "typo3-kate-$1.override"; }

coredns_set() {   # <namespace> <domain>
  local key rule
  key="$(coredns_key "$1")"
  rule="rewrite name exact $2 traefik.kube-system.svc.cluster.local"
  if kubectl -n kube-system get configmap coredns-custom >/dev/null 2>&1; then
    kubectl -n kube-system patch configmap coredns-custom --type merge \
      -p "$(jq -nc --arg k "${key}" --arg v "${rule}" '{data: {($k): $v}}')" >/dev/null
  else
    kubectl -n kube-system create configmap coredns-custom --from-literal="${key}=${rule}" >/dev/null
  fi
}

coredns_unset() {   # <namespace>
  local key
  key="$(coredns_key "$1")"
  kubectl -n kube-system get configmap coredns-custom -o json 2>/dev/null \
    | jq -e --arg k "${key}" '.data[$k] != null' >/dev/null 2>&1 || return 0
  kubectl -n kube-system patch configmap coredns-custom --type json \
    -p "$(jq -nc --arg k "${key}" '[{op: "remove", path: ("/data/" + $k)}]')" >/dev/null
}

# --- deployed sites ---------------------------------------------------------------------
# deployed_sites: the sites the cluster knows (namespace annotation typo3-kate/project)
deployed_sites() {
  kubectl get namespaces -o json | jq -r '.items[].metadata.annotations["typo3-kate/project"] // empty' | sort -u
}
# site_namespace <site>: NAMESPACE of a deployed site. The annotation survives
# a renamed or deleted projects/ folder, so it wins over kate.yaml.
site_namespace() {
  local project="$1" annotated
  NAMESPACE="${project}"
  if [ -f "${ROOT}/projects/${project}/kate.yaml" ]; then
    NAMESPACE="$(yq -r ".namespace // \"${project}\"" "${ROOT}/projects/${project}/kate.yaml")"
  fi
  annotated="$(kubectl get namespaces -o json | jq -r --arg p "${project}" \
    '.items[] | select(.metadata.annotations["typo3-kate/project"] == $p) | .metadata.name' | head -1)"
  NAMESPACE="${annotated:-${NAMESPACE}}"
  kubectl get namespace "${NAMESPACE}" >/dev/null 2>&1 || fail "site ${project} is not deployed (no namespace ${NAMESPACE})"
}

# The command that puts stdin on the clipboard (for --copy)
clipboard_cmd() {
  local tool
  for tool in pbcopy wl-copy xclip xsel; do
    command -v "${tool}" >/dev/null || continue
    case "${tool}" in
      xclip) echo "xclip -selection clipboard" ;;
      xsel) echo "xsel --clipboard --input" ;;
      *) echo "${tool}" ;;
    esac
    return
  done
  fail "--copy needs pbcopy, wl-copy, xclip or xsel"
}

# --- password: the backend login of a site ----------------------------------------------
cmd_password() {
  local project="" copy=false arg
  for arg in "$@"; do
    case "${arg}" in
      --copy) copy=true ;;
      -*) fail "Usage: ./kate password [<site>] [--copy]" ;;
      *) [ -z "${project}" ] || fail "one site at a time"; project="${arg}" ;;
    esac
  done
  need kubectl jq yq tofu
  local clip=""
  [ "${copy}" = false ] || clip="$(clipboard_cmd)"
  connect
  if [ -z "${project}" ]; then
    local deployed
    deployed="$(deployed_sites)"
    [ -n "${deployed}" ] || fail "no deployed site found"
    # shellcheck disable=SC2086 # one site per line
    project="$(ask_choose "<site>" "Backend login of which site?" ${deployed})"
  fi
  site_namespace "${project}"
  k get secret typo3-admin >/dev/null 2>&1 || fail "no Secret typo3-admin in ${NAMESPACE}"

  local user password domain url
  user="$(secret_value typo3-admin username)"
  password="$(secret_value typo3-admin password)"
  domain="$(kubectl get namespace "${NAMESPACE}" -o json | jq -r '.metadata.annotations["typo3-kate/domain"] // ""')"
  url="https://${domain:-${MASTER_IP}}/typo3"
  if [ "${copy}" = true ]; then
    # shellcheck disable=SC2086 # the tool and its options
    printf '%s' "${password}" | ${clip}
    gum style --border rounded --padding "0 1" >&2 "Backend:  ${url}" "User:     ${user}" "Password: copied to the clipboard"
  else
    gum style --border rounded --padding "0 1" >&2 "Backend:  ${url}" "User:     ${user}"
    # stdout, so ./kate password <site> | pbcopy also works
    echo "${password}"
  fi
}

# --- garage: Garage's web admin for a site ------------------------------------------------
# garage_port <namespace>: the site's local port for the UI, the same every time
garage_port() { echo $((39000 + $(printf '%s' "$1" | cksum | cut -d' ' -f1) % 1000)); }

# Garage (>= 2.6) serves a web admin under /ui/ on its admin port; it asks for
# the admin token from Secret typo3-garage. The browser keeps that login per
# address, and every site's Garage has its own token, so each site gets its own
# local port (the same every time): a login from another site's Garage under
# the same address is what "Invalid bearer token" usually means.
cmd_garage() {
  local project="" address=127.0.0.1 port="" copy=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --address) [ $# -ge 2 ] || fail "--address needs an IP address"; address="$2"; shift ;;
      --port) [ $# -ge 2 ] || fail "--port needs a number"; port="$2"; shift ;;
      --copy) copy=true ;;
      -*) fail "Usage: ./kate garage [<site>] [--address <ip>] [--port <n>] [--copy]" ;;
      *) [ -z "${project}" ] || fail "unexpected '$1': ./kate garage takes one site and prints the URL itself (--address <ip>, --port <n> to choose it)"
         project="$1" ;;
    esac
    shift
  done
  [ -z "${port}" ] || { [[ "${port}" =~ ^[0-9]+$ ]] && [ "${port}" -ge 1024 ] && [ "${port}" -le 65535 ]; } \
    || fail "--port must be a number from 1024 to 65535, not '${port}'"
  need kubectl jq yq tofu
  local clip=""
  [ "${copy}" = false ] || clip="$(clipboard_cmd)"
  connect
  if [ -z "${project}" ]; then
    local deployed
    deployed="$(deployed_sites)"
    [ -n "${deployed}" ] || fail "no deployed site found"
    # shellcheck disable=SC2086 # one site per line
    project="$(ask_choose "<site>" "Garage of which site?" ${deployed})"
  fi
  # A namespace instead of the site's name: say which site it is
  if [ ! -f "${ROOT}/projects/${project}/kate.yaml" ]; then
    local owner
    owner="$(kubectl get namespace "${project}" -o json 2>/dev/null | jq -r '.metadata.annotations["typo3-kate/project"] // ""' || true)"
    [ -z "${owner}" ] || fail "${project} is the namespace of site ${owner}: ./kate garage ${owner}"
  fi
  site_namespace "${project}"
  k get pod garage-0 >/dev/null 2>&1 || fail "no pod garage-0 in ${NAMESPACE}: is the site deployed?"
  k get secret typo3-garage >/dev/null 2>&1 || fail "no Secret typo3-garage in ${NAMESPACE}"
  # The same port for a site every time, another one for each site
  [ -n "${port}" ] || port="$(garage_port "${NAMESPACE}")"

  local token
  token="$(secret_value typo3-garage admin-token)"
  local lines=("Garage UI: http://${address}:${port}/ui/")
  if [ "${copy}" = true ]; then
    # shellcheck disable=SC2086 # the tool and its options
    printf '%s' "${token}" | ${clip}
    lines+=("Token:     copied to the clipboard")
  else
    lines+=("Token:     printed below")
  fi
  lines+=("" "\"Invalid bearer token\"? Log out in the UI: this browser" "still has another site's token for this address." "Ctrl-C ends it.")
  gum style --border rounded --padding "0 1" >&2 "${lines[@]}"
  # stdout, so ./kate garage <site> | head -1 also works
  [ "${copy}" = true ] || echo "${token}"
  k port-forward --address "${address}" pod/garage-0 "${port}:3903" >/dev/null
}

# --- composer: for a site, with its own PHP ------------------------------------------------
# Runs composer in projects/<site>/ inside the site's base image (its php: and
# imgproxy variant), so PHP and extensions match the production image and the
# host's PHP doesn't matter. The repository is mounted whole, so the path
# repositories ../../packages/* and packages/* resolve; files are written as
# the calling user. The base image has no composer: a tiny image on top adds
# it from composer:2 (cached by docker).
cmd_composer() {
  [ $# -ge 1 ] && [[ "$1" != -* ]] || fail "Usage: ./kate composer <site> [<composer arguments>], e.g. ./kate composer shop require vendor/package"
  load_project "$1"
  shift
  need docker
  local base tag
  base="${BASE_IMAGE}:${PHP_VERSION}$([ "${IMGPROXY}" = true ] && echo -imgproxy || true)"
  tag="typo3-kate-composer:${PHP_VERSION}$([ "${IMGPROXY}" = true ] && echo -imgproxy || true)"
  # Current base when the registry answers, the cached one otherwise
  local context
  context="$(mktemp -d)"
  printf 'FROM %s\nCOPY --from=composer:2 /usr/bin/composer /usr/bin/composer\n' "${base}" > "${context}/Dockerfile"
  wait_for "composer image on ${base}" docker build --pull -q -t "${tag}" "${context}" >/dev/null 2>&1 \
    || docker build -q -t "${tag}" "${context}" >/dev/null \
    || { rm -rf "${context}"; fail "no composer image on ${base}: is it pulled or reachable?"; }
  rm -rf "${context}"

  local cache="${COMPOSER_CACHE_DIR:-${XDG_CACHE_HOME:-${HOME}/.cache}/composer}" auth="" file
  mkdir -p "${cache}"
  # Logins for private repositories, from this machine's composer
  for file in "${COMPOSER_HOME:-${HOME}/.composer}/auth.json" "${HOME}/.config/composer/auth.json"; do
    [ -f "${file}" ] && { auth="$(cat "${file}")"; break; }
  done
  local tty=()
  [ ! -t 0 ] || [ ! -t 1 ] || tty=(-t)
  note "composer $* in projects/${PROJECT} (PHP ${PHP_VERSION})"
  docker run --rm -i ${tty[@]+"${tty[@]}"} \
    -u "$(id -u):$(id -g)" \
    -v "${ROOT}:/src" -w "/src/projects/${PROJECT}" \
    -v "${cache}:/composer-cache" \
    -e HOME=/tmp -e COMPOSER_HOME=/tmp/composer -e COMPOSER_CACHE_DIR=/composer-cache \
    ${auth:+-e COMPOSER_AUTH="${auth}"} \
    "${tag}" composer "$@"
}

# --- reprocess: a site's processed images, made again --------------------------------------
# reprocess_site: in NAMESPACE (connected), delete the processed files of every
# storage and flush the page cache; TYPO3 creates each image again on its next
# request, with the image processing configured now.
reprocess_site() {
  local backend="deploy/${RELEASE}-backend"
  if kubectl -n "${NAMESPACE}" exec "${backend}" -- vendor/bin/typo3 list --raw 2>/dev/null | grep -q '^kate:processed-files:reset '; then
    wait_for "deleting the processed files of every storage" \
      kubectl -n "${NAMESPACE}" exec "${backend}" -- vendor/bin/typo3 kate:processed-files:reset
  else
    # Without ochorocho/kate-imgproxy: EXT:lowlevel, local storages only
    note "ochorocho/kate-imgproxy isn't installed: only storages with the Local driver (fileadmin) are reset, not S3"
    wait_for "deleting the processed files of local storages" \
      kubectl -n "${NAMESPACE}" exec "${backend}" -- vendor/bin/typo3 cleanup:localprocessedfiles --all --force \
      || fail "neither kate:processed-files:reset nor cleanup:localprocessedfiles (EXT:lowlevel) is available in ${PROJECT}"
  fi
  # Cached pages would keep pointing to the deleted files
  wait_for "flushing the page cache" kubectl -n "${NAMESPACE}" exec "${backend}" -- vendor/bin/typo3 cache:flush --group pages
  note "Processed images reset: each is made again on its first request"
}

cmd_reprocess() {
  local project="" arg
  for arg in "$@"; do
    case "${arg}" in
      -*) fail "Usage: ./kate reprocess [<site>]" ;;
      *) [ -z "${project}" ] || fail "one site at a time"; project="${arg}" ;;
    esac
  done
  need kubectl jq yq tofu
  connect
  if [ -z "${project}" ]; then
    local deployed
    deployed="$(deployed_sites)"
    [ -n "${deployed}" ] || fail "no deployed site found"
    # shellcheck disable=SC2086 # one site per line
    project="$(ask_choose "<site>" "Process the images of which site again?" ${deployed})"
  fi
  PROJECT="${project}"
  site_namespace "${project}"
  step "Processing the images of ${project} again"
  reprocess_site
}

# --- logs: what a site's pods write ------------------------------------------------------
# log_selector <component>: the label selector of its pods
log_selector() {
  case "$1" in
    typo3) echo "app.kubernetes.io/instance=${RELEASE},app.kubernetes.io/name=typo3" ;;
    frontend | backend | messenger | scheduler | mercure | migrations)
      echo "app.kubernetes.io/instance=${RELEASE},app.kubernetes.io/component=$1" ;;
    mariadb) echo "app.kubernetes.io/instance=typo3-mariadb" ;;
    valkey) echo "app.kubernetes.io/instance=typo3-valkey" ;;
    valkey-cache) echo "app.kubernetes.io/instance=typo3-valkey-cache" ;;
    garage) echo "app.kubernetes.io/name=garage" ;;
    *) return 1 ;;
  esac
}
LOG_COMPONENTS="typo3 frontend backend messenger scheduler mercure migrations mariadb valkey valkey-cache garage"

cmd_logs() {
  local usage="Usage: ./kate logs [<site>] [<component>] [-f|--follow] [--since <duration>] [--tail <lines>]"
  local project="" component="" follow=false since="" tail=100
  while [ $# -gt 0 ]; do
    case "$1" in
      -f | --follow) follow=true; shift ;;
      --since) [ $# -ge 2 ] || fail "${usage}"; since="$2"; shift 2 ;;
      --tail) [ $# -ge 2 ] || fail "${usage}"; tail="$2"; shift 2 ;;
      -*) fail "${usage}" ;;
      *)
        if [ -z "${project}" ]; then project="$1"
        elif [ -z "${component}" ]; then component="$1"
        else fail "${usage}"; fi
        shift ;;
    esac
  done
  [[ "${tail}" =~ ^-?[0-9]+$ ]] || fail "--tail takes a number of lines (-1: all)"
  if [ -n "${component}" ]; then
    log_selector "${component}" >/dev/null || fail "unknown component ${component}: one of ${LOG_COMPONENTS}"
  fi
  need kubectl jq yq tofu
  connect
  if [ -z "${project}" ]; then
    local deployed
    deployed="$(deployed_sites)"
    [ -n "${deployed}" ] || fail "no deployed site found"
    # shellcheck disable=SC2086 # one site per line
    project="$(ask_choose "<site>" "Logs of which site?" ${deployed})"
  fi
  site_namespace "${project}"
  if [ -z "${component}" ]; then
    if interactive; then
      # shellcheck disable=SC2086 # one component per word
      component="$(gum choose --header "Which pods? (typo3: all TYPO3 pods)" ${LOG_COMPONENTS})"
    else
      component=typo3
    fi
  fi

  local selector
  selector="$(log_selector "${component}")"
  [ -n "$(kubectl -n "${NAMESPACE}" get pods -l "${selector}" -o name)" ] \
    || fail "no ${component} pods in ${NAMESPACE} (the scheduler and migrations run only now and then; finished pods are kept for a while)"
  local since_arg=()
  [ -z "${since}" ] || since_arg=(--since="${since}")
  if [ "${follow}" = true ]; then
    note "${project} (${NAMESPACE}): ${component}, following: Ctrl-C to stop"
    # --ignore-errors: init containers that haven't started yet don't end it
    kubectl -n "${NAMESPACE}" logs -l "${selector}" --prefix --all-containers --ignore-errors \
      --max-log-requests=20 --tail="${tail}" ${since_arg[@]+"${since_arg[@]}"} --follow
    return
  fi
  # One container at a time, only those that have run: a failed migrations
  # step leaves the next ones waiting, and kubectl logs --all-containers
  # would stop at the first of them
  note "${project} (${NAMESPACE}): ${component}"
  local pod container
  while read -r pod container; do
    [ -n "${pod}" ] || continue
    kubectl -n "${NAMESPACE}" logs "${pod}" -c "${container}" --tail="${tail}" ${since_arg[@]+"${since_arg[@]}"} \
      | sed "s|^|[pod/${pod}/${container}] |"
  done < <(kubectl -n "${NAMESPACE}" get pods -l "${selector}" -o json | jq -r '
    .items | sort_by(.metadata.creationTimestamp)[] | .metadata.name as $pod
    | ((.status.initContainerStatuses // []) + (.status.containerStatuses // []))[]
    | select(.state.running or .state.terminated or .lastState.terminated)
    | "\($pod) \(.name)"')
}

# --- remove: a site's release, namespace and volumes ---------------------------------
# The files in projects/<site>/ stay. The NFS volumes (fileadmin, typo3temp
# assets) have reclaimPolicy Retain, so their data stays on the master unless
# --delete-volumes switches them to Delete first: then csi-driver-nfs removes
# the directories itself (onDelete: delete, its default).
cmd_remove() {
  local project="" yes=false delete_volumes="" arg
  for arg in "$@"; do
    case "${arg}" in
      --yes) yes=true ;;
      --delete-volumes) delete_volumes=true ;;
      -*) fail "Usage: ./kate remove [<site>] [--yes] [--delete-volumes]" ;;
      *) [ -z "${project}" ] || fail "one site at a time"; project="${arg}" ;;
    esac
  done
  need kubectl helm jq yq tofu
  connect

  if [ -z "${project}" ]; then
    local deployed
    deployed="$(deployed_sites)"
    [ -n "${deployed}" ] || fail "no deployed site found"
    # shellcheck disable=SC2086 # one site per line
    project="$(ask_choose "<site>" "Remove which site from the cluster?" ${deployed})"
  fi
  site_namespace "${project}"
  local owner
  owner="$(kubectl get namespace "${NAMESPACE}" -o json | jq -r '.metadata.annotations["typo3-kate/project"] // ""')"
  [ "${owner}" = "${project}" ] \
    || fail "namespace ${NAMESPACE} is not marked as site ${project} (annotation typo3-kate/project: '${owner}'); deploy it once with ./kate deploy ${project}, or remove it by hand"

  # NFS volumes use reclaimPolicy Retain: remember them before the claims go
  local pvs
  pvs="$(kubectl get pv -o json | jq -r --arg ns "${NAMESPACE}" \
    '.items[] | select(.spec.claimRef.namespace == $ns) | "\(.metadata.name) \(.spec.persistentVolumeReclaimPolicy) \(.spec.csi.volumeHandle // "-")"')"

  local retained
  retained="$(awk '$2 == "Retain" {print $1}' <<<"${pvs}")"
  # Default no: asked on a terminal (unless --yes), kept otherwise
  if [ -z "${delete_volumes}" ]; then
    delete_volumes=false
    if [ -n "${retained}" ] && [ "${yes}" = false ] && interactive; then
      gum confirm --default=false \
        "Also delete the retained volumes (fileadmin and typo3temp assets on the NFS server)?" \
        && delete_volumes=true
    fi
  fi

  local lines=("Site ${project}: namespace ${NAMESPACE} with its database, files and Secrets")
  if [ -n "${pvs}" ]; then
    local line
    while read -r line; do lines+=("  volume ${line}"); done <<<"${pvs}"
  fi
  if [ -n "${retained}" ]; then
    if [ "${delete_volumes}" = true ]; then
      lines+=("Retained NFS volumes: DELETED, with their data")
    else
      lines+=("Retained NFS volumes: kept on the NFS server (--delete-volumes deletes them)")
    fi
  fi
  gum style --border rounded --border-foreground 196 --padding "0 1" >&2 "${lines[@]}"
  if [ "${yes}" = false ]; then
    local answer
    answer="$(ask_input "--yes" "Type the site name to delete it" "" "${project}")"
    [ "${answer}" = "${project}" ] || fail "not confirmed, nothing deleted"
  fi

  local name
  if [ "${delete_volumes}" = true ]; then
    # Delete instead of Retain: releasing the claim then removes the PV and its directory
    for name in ${retained}; do
      kubectl patch pv "${name}" -p '{"spec":{"persistentVolumeReclaimPolicy":"Delete"}}' >/dev/null
    done
  fi

  # Keep its certificate: deploying the site again then orders none
  local site_domain
  site_domain="$(kubectl get namespace "${NAMESPACE}" -o json | jq -r '.metadata.annotations["typo3-kate/domain"] // ""')"
  # Its use of the wildcard certificate (which stays for the other sites), and
  # its in-cluster DNS rule for imgproxy
  kubectl -n gateway-system delete referencegrant "site-${NAMESPACE}" --ignore-not-found >/dev/null
  coredns_unset "${NAMESPACE}"
  if [ -n "${site_domain}" ] && kubectl -n "${NAMESPACE}" get secret site-tls >/dev/null 2>&1; then
    save_certificate "${NAMESPACE}" site-tls "${site_domain}"
    note "Certificate for ${site_domain} kept in ${CERT_DIR}"
  fi

  wait_for "helm uninstall" sh -c "helm -n '${NAMESPACE}' uninstall '${RELEASE}' --wait 2>/dev/null || true"
  wait_for "deleting namespace ${NAMESPACE}" kubectl delete namespace "${NAMESPACE}" --wait --timeout=10m

  local policy handle
  if [ "${delete_volumes}" = true ]; then
    for name in ${retained}; do
      wait_for "deleting volume ${name} and its data" kubectl wait pv/"${name}" --for=delete --timeout=5m \
        || fail "volume ${name} is still there: kubectl describe pv ${name} (the NFS driver deletes its directory)"
    done
  else
    # The Retain volumes are Released now; their objects can go, the data stays
    while read -r name policy handle; do
      [ -n "${name}" ] && [ "${policy}" = Retain ] || continue
      kubectl delete pv "${name}" --ignore-not-found >/dev/null
      note "data kept on the NFS server: ${handle}"
    done <<<"${pvs}"
  fi
  step "Removed ${project}"
  if [ "${delete_volumes}" = true ] || [ -z "${retained}" ]; then
    note "Left to you: its DNS record."
  else
    note "Left to you: its DNS record and, when no longer needed, the NFS data above (on the master under /srv/nfs)."
  fi
}

# --- autocomplete: tab completion for bash and zsh ----------------------------------
# The completion reads the site names from projects/ next to the kate that is
# being completed, so it fits every checkout and new sites need no reinstall.
completion_bash() {
  cat <<'BASH'
# typo3-kate: tab completion for ./kate (written by ./kate autocomplete)
_kate() {
  local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD-1]}"
  local cmd="${COMP_WORDS[1]:-}" dir sites="" deployable="" f site words
  dir="$(dirname -- "${COMP_WORDS[0]}")"
  for f in "${dir}"/projects/*/composer.json; do
    [ -e "${f}" ] || continue
    site="$(basename "$(dirname "${f}")")"
    sites="${sites} ${site}"
    # kate is deployed by name only
    [ "${site}" = kate ] || deployable="${deployable} ${site}"
  done
  if [ "${COMP_CWORD}" -eq 1 ]; then
    words="deploy new status logs password garage certificates reprocess composer dns remove values manifests autocomplete help"
  else
    case "${cmd}:${prev}" in
      new:--acme) words="staging production" ;;
      new:--php) words="8.5 8.4" ;;
      new:--from) words="${sites}" ;;
      manifests:--issuer) words="letsencrypt letsencrypt-staging" ;;
      new:--domain | new:--namespace | values:--hostname | manifests:--hostname | logs:--since | logs:--tail | dns:--ip | dns:--ttl | garage:--address | garage:--port) COMPREPLY=(); return ;;
      *)
        case "${cmd}" in
          deploy) words="${deployable} --all --no-build" ;;
          new) words="--domain --acme --namespace --php --node-ips --from" ;;
          remove) words="${sites} --yes --delete-volumes" ;;
          password) words="${sites} --copy" ;;
          garage) words="${sites} --address --port --copy" ;;
          reprocess) words="${sites}" ;;
          composer)
            if [ "${COMP_CWORD}" -eq 2 ]; then words="${sites}"
            else words="require remove update install show outdated why why-not validate dump-autoload config"; fi ;;
          dns) words="--ip --ttl --yes" ;;
          logs)
            # the site first, then the component
            if [ "${COMP_CWORD}" -eq 2 ]; then words="${sites} -f --since --tail"
            else words="typo3 frontend backend messenger scheduler mercure migrations mariadb valkey valkey-cache garage -f --since --tail"; fi ;;
          values) words="--hostname --node-ips" ;;
          manifests) words="--hostname --issuer --node-ips" ;;
          autocomplete) words="bash zsh --print" ;;
          *) words="" ;;
        esac ;;
    esac
  fi
  # shellcheck disable=SC2207 # compgen prints one word per line
  COMPREPLY=($(compgen -W "${words}" -- "${cur}"))
}
complete -F _kate kate ./kate
BASH
}

completion_zsh() {
  cat <<'ZSH'
# typo3-kate: tab completion for ./kate (written by ./kate autocomplete)
(( $+functions[compdef] )) || { autoload -Uz compinit && compinit; }
_kate() {
  local cmd="${words[2]}" prev="${words[CURRENT-1]}"
  local -a sites commands
  sites=( ${words[1]:h}/projects/*/composer.json(N:h:t) )
  if (( CURRENT == 2 )); then
    commands=(
      'deploy:build and roll out a site'
      'new:create a site from projects/_example'
      'status:every site and its state'
      'password:backend login of a site'
      'garage:the Garage web admin of a site'
      'logs:what the pods of a site write'
      'certificates:the saved certificate copies'
      'reprocess:make every processed image of a site again'
      'composer:composer for a site, with its own PHP'
      'dns:the wildcard DNS record at Hetzner'
      'remove:remove a site from the cluster'
      'values:Helm values of a site (CI)'
      'manifests:Gateway, certificate and media route of a site (CI)'
      'autocomplete:install this tab completion'
      'help:usage'
    )
    _describe -t commands 'kate command' commands
    return
  fi
  case "${cmd}:${prev}" in
    new:--acme) compadd staging production; return ;;
    new:--php) compadd 8.5 8.4; return ;;
    new:--from) compadd -a sites; return ;;
    manifests:--issuer) compadd letsencrypt letsencrypt-staging; return ;;
    new:--domain|new:--namespace|values:--hostname|manifests:--hostname|logs:--since|logs:--tail|dns:--ip|dns:--ttl|garage:--address|garage:--port) _message 'value'; return ;;
  esac
  case "${cmd}" in
    deploy) compadd -- ${sites:#kate}; compadd -- --all --no-build ;;
    new) compadd -- --domain --acme --namespace --php --node-ips --from ;;
    remove) compadd -a sites; compadd -- --yes --delete-volumes ;;
    password) compadd -a sites; compadd -- --copy ;;
    garage) compadd -a sites; compadd -- --address --port --copy ;;
    reprocess) compadd -a sites ;;
    composer)
      if (( CURRENT == 3 )); then compadd -a sites
      else compadd require remove update install show outdated why why-not validate dump-autoload config; fi ;;
    dns) compadd -- --ip --ttl --yes ;;
    logs)
      if (( CURRENT == 3 )); then compadd -a sites
      else compadd typo3 frontend backend messenger scheduler mercure migrations mariadb valkey valkey-cache garage; fi
      compadd -- -f --since --tail ;;
    values) compadd -- --hostname --node-ips ;;
    manifests) compadd -- --hostname --issuer --node-ips ;;
    autocomplete) compadd bash zsh; compadd -- --print ;;
  esac
}
compdef _kate kate ./kate
ZSH
}

cmd_autocomplete() {
  local shell="" print=false arg
  for arg in "$@"; do
    case "${arg}" in
      bash | zsh) shell="${arg}" ;;
      --print) print=true ;;
      *) fail "Usage: ./kate autocomplete [bash|zsh] [--print]" ;;
    esac
  done
  if [ -z "${shell}" ]; then
    shell="$(basename "${SHELL:-}")"
    [[ "${shell}" == bash || "${shell}" == zsh ]] \
      || shell="$(ask_choose "bash or zsh" "Completion for which shell? (\$SHELL is ${SHELL:-unset})" zsh bash)"
  fi
  if [ "${print}" = true ]; then
    "completion_${shell}"
    return
  fi

  local dir="${XDG_CONFIG_HOME:-${HOME}/.config}/typo3-kate" rc
  local file="${dir}/completion.${shell}"
  case "${shell}" in
    zsh) rc="${ZDOTDIR:-${HOME}}/.zshrc" ;;
    bash) rc="${HOME}/.bashrc" ;;
  esac
  mkdir -p "${dir}"
  "completion_${shell}" > "${file}"
  local line="[ -f \"${file}\" ] && . \"${file}\"   # typo3-kate: ./kate autocomplete"
  if [ -f "${rc}" ] && grep -qF "# typo3-kate: ./kate autocomplete" "${rc}"; then
    note "${rc} loads it already"
  else
    printf '\n%s\n' "${line}" >> "${rc}"
    note "Added to ${rc}: ${line}"
  fi
  step "Tab completion for ${shell} in ${file}"
  note "Open a new shell (or: . ${file}) and try: ./kate <Tab>"
  [ "${shell}" = zsh ] || note "macOS: bash login shells read ~/.bash_profile; source ~/.bashrc from there if needed"
}

# --- main ------------------------------------------------------------------------------
usage() { sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//' >&2; }

command="${1:-}"
[ $# -eq 0 ] || shift
if [ -z "${command}" ]; then
  interactive || { usage; exit 1; }
  command="$(gum choose --header "typo3-kate" deploy new status logs password garage certificates reprocess dns remove autocomplete help)"
fi
case "${command}" in
  deploy) cmd_deploy "$@" ;;
  new) cmd_new "$@" ;;
  status) cmd_status "$@" ;;
  remove) cmd_remove "$@" ;;
  password) cmd_password "$@" ;;
  garage) cmd_garage "$@" ;;
  logs) cmd_logs "$@" ;;
  certificates) cmd_certificates "$@" ;;
  reprocess) cmd_reprocess "$@" ;;
  composer) cmd_composer "$@" ;;
  dns) cmd_dns "$@" ;;
  values) cmd_values "$@" ;;
  manifests) cmd_manifests "$@" ;;
  __wait-certificate) cmd_wait_certificate "$@" ;;   # internal, run under a spinner
  autocomplete) cmd_autocomplete "$@" ;;
  help | -h | --help) usage ;;
  *) usage; exit 1 ;;
esac
